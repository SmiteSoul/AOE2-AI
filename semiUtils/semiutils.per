; ==========================================================
; PRODUCCION MILITAR - TEMPRANA
; Poco spam, solo base militar inicial
; ==========================================================

(defrule
    (current-age == dark-age)
    (building-type-count-total barracks > 0)
    (can-train militiaman-line)
    (unit-type-count-total militiaman-line < 2)
=>
    (train militiaman-line)
)

(defrule
    (current-age == feudal-age)
    (goal gl-mode m-attack)
    (can-train militiaman-line)
    (unit-type-count-total militiaman-line < 4)
=>
    (train militiaman-line)
)

(defrule
    (current-age == feudal-age)
    (town-under-attack)
    (can-train skirmisher-line)
    (unit-type-count-total skirmisher-line < 5)
=>
    (train skirmisher-line)
)

; ==========================================================
; PRODUCCION MILITAR - CASTILLO
; Aqui empieza a armar ejercitos serios
; ==========================================================

(defrule
    (current-age == castle-age)
    (goal gl-mode m-boom)
