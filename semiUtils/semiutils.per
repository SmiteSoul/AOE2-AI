; ==========================================================
; AJUSTE DE MERCADO PARA SUBIDAS / CASTILLOS
; ==========================================================

(defrule
    (current-age == castle-age)
    (gold-amount > 1400)
    (food-amount < 900)
    (can-buy-commodity food)
=>
    (buy-commodity food)
)

(defrule
    (current-age >= castle-age)
    (gold-amount > 1600)
    (stone-amount < 650)
    (can-buy-commodity stone)
=>
    (buy-commodity stone)
)

; ==========================================================
; SUBIDAS DE EDAD
; ==========================================================

(defrule
    (current-age == dark-age)
    (can-research feudal-age)
=>
    (research feudal-age)
    (chat-to-all "Conquistador: avanzando a Feudal.")
)

(defrule
    (current-age == feudal-age)
    (can-research castle-age)
=>
    (research castle-age)
    (chat-to-all "Conquistador: avanzando a Castillo.")
)

(defrule
    (current-age == castle-age)
    (can-research imperial-age)
=>
    (research imperial-age)
    (chat-to-all "Conquistador: avanzando a Imperial.")
)

; ==========================================================
; ALL-IN - ACTIVACION
; Solo desde Castillo+ y con ejercito serio segun pop cap
; ==========================================================

; 75 pop
(defrule
    (not (goal gl-mode m-all-in))
    (goal gl-diplo d-war)
    (current-age >= castle-age)
    (population-cap <= 75)
    (soldier-count >= 18)
=>
    (set-goal gl-mode m-all-in)
    (chat-to-all "Conquistador: guerra total. El reino entra en movilizacion.")
)

; 100 pop
(defrule
    (not (goal gl-mode m-all-in))
    (goal gl-diplo d-war)
    (current-age >= castle-age)
    (population-cap > 75)
    (population-cap <= 100)
    (soldier-count >= 22)
=>
    (set-goal gl-mode m-all-in)
    (chat-to-all "Conquistador: guerra total. El reino entra en movilizacion.")
)

; 150 pop
(defrule
    (not (goal gl-mode m-all-in))
    (goal gl-diplo d-war)
    (current-age >= castle-age)
    (population-cap > 100)
    (population-cap <= 150)
    (soldier-count >= 28)
=>
    (set-goal gl-mode m-all-in)
    (chat-to-all "Conquistador: guerra total. El reino entra en movilizacion.")
)

; 200 pop
(defrule
    (not (goal gl-mode m-all-in))
    (goal gl-diplo d-war)
    (current-age >= castle-age)
    (population-cap > 150)
    (soldier-count >= 34)
=>
    (set-goal gl-mode m-all-in)
    (chat-to-all "Conquistador: guerra total. El reino entra en movilizacion.")
)

; Late-game forzado si la partida se alarga
; 75/100 pop
(defrule
    (not (goal gl-mode m-all-in))
    (current-age >= imperial-age)
    (game-time > 3000)
    (population-cap <= 100)
    (soldier-count >= 16)
=>
    (set-goal gl-mode m-all-in)
    (chat-to-all "Conquistador: se acabo la contencion. ¡Asalto total!")
)

; 150/200 pop
(defrule
    (not (goal gl-mode m-all-in))
    (current-age >= imperial-age)
    (game-time > 3000)
    (population-cap > 100)
    (soldier-count >= 24)
=>
    (set-goal gl-mode m-all-in)
    (chat-to-all "Conquistador: se acabo la contencion. ¡Asalto total!")
)

; Configuracion real del all-in
(defrule
    (goal gl-mode m-all-in)
    (not (strategic-number sn-number-attack-groups == 6))
=>
    (set-strategic-number sn-percent-attack-soldiers 100)
    (set-strategic-number sn-number-attack-groups 6)
    (set-strategic-number sn-minimum-attack-group-size 10)
    (set-strategic-number sn-maximum-attack-group-size 18)
    (set-strategic-number sn-group-form-distance 120)
    (attack-now)
)

; ==========================================================
; ALL-IN - REAJUSTE ECONOMICO
; Corta boom, pero deja suficientes builders para castillos/talleres
; ==========================================================

(defrule
    (goal gl-mode m-all-in)
    (not (strategic-number sn-percent-civilian-explorers == 0))
=>
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-cap-civilian-explorers 0)
    (set-strategic-number sn-percent-civilian-builders 5)
    (set-strategic-number sn-percent-civilian-gatherers 95)
    (set-strategic-number sn-cap-civilian-builders 6)
    (set-strategic-number sn-food-gatherer-percentage 30)
    (set-strategic-number sn-wood-gatherer-percentage 18)
    (set-strategic-number sn-gold-gatherer-percentage 42)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

