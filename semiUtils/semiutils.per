    (can-build market)
=>
    (build market)
)

(defrule
    (current-age >= feudal-age)
    (building-type-count-total mining-camp == 0)
    (can-build mining-camp)
=>
    (build mining-camp)
)

(defrule
    (current-age >= feudal-age)
    (building-type-count-total stable == 0)
    (can-build stable)
=>
    (build stable)
)

(defrule
    (current-age >= feudal-age)
    (building-type-count-total archery-range == 0)
    (can-build archery-range)
=>
    (build archery-range)
)

(defrule
    (current-age >= castle-age)
    (building-type-count-total town-center < 2)
    (can-build town-center)
=>
    (build town-center)
)

(defrule
    (current-age >= castle-age)
    (building-type-count-total town-center < 3)
    (can-build town-center)
=>
    (build town-center)
)

(defrule
    (current-age >= castle-age)
    (building-type-count-total stable < 2)
    (can-build stable)
=>
    (build stable)
)

(defrule
    (current-age >= imperial-age)
    (building-type-count-total stable < 3)
    (can-build stable)
=>
    (build stable)
)

(defrule
    (current-age >= castle-age)
    (building-type-count-total siege-workshop == 0)
    (can-build siege-workshop)
=>
    (build siege-workshop)
)

(defrule
    (current-age >= castle-age)
    (building-type-count-total university == 0)
    (can-build university)
=>
    (build university)
)

; ==========================================================
; MURALLAS Y PUERTAS
; ==========================================================

(defrule
    (current-age >= feudal-age)
    (wall-completed-percentage 1 < 100)
    (can-build-wall 1 palisade-wall)
=>
    (build-wall 1 palisade-wall)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 1 < 100)
    (can-build-wall 1 stone-wall)
=>
    (build-wall 1 stone-wall)
)

(defrule
    (wall-completed-percentage 1 > 20)
    (can-build-gate 1)
=>
    (build-gate 1)
)

; ==========================================================
; CASTILLOS
; ==========================================================

(defrule
    (current-age >= castle-age)
    (stone-amount >= 650)
    (building-type-count-total castle == 0)
    (can-build castle)
=>
    (build castle)
)

(defrule
    (current-age >= imperial-age)
    (stone-amount >= 650)
    (building-type-count-total castle < 2)
    (can-build castle)
=>
    (build castle)
)

(defrule
    (current-age >= imperial-age)
    (stone-amount >= 650)
    (building-type-count-total castle >= 1)
    (building-type-count-total castle < 3)
    (player-in-game any-enemy)
    (can-build castle)
=>
    (build-forward castle)
)

; ==========================================================
; GRANJAS
; ==========================================================

(defrule
    (current-age >= feudal-age)
    (food-amount < 300)
    (wood-amount > 80)
    (can-build farm)
=>
    (build farm)
)

