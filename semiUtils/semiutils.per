; ==========================================================
; COMERCIO
; ==========================================================

(defrule
    (current-age >= castle-age)
    (players-building-type-count any-ally market > 0)
    (can-train trade-cart)
    (unit-type-count-total trade-cart < 10)
=>
    (train trade-cart)
)

(defrule
    (current-age == imperial-age)
    (players-building-type-count any-ally market > 0)
    (can-train trade-cart)
    (unit-type-count-total trade-cart < 20)
=>
    (train trade-cart)
)

; ==========================================================
; TRIBUTOS A ALIADOS
; ==========================================================

(defrule
    (gold-amount > 1500)
    (players-population any-ally > 20)
=>
    (tribute-to-player this-any-ally gold 100)
)

; ==========================================================
; DIPLOMACIA AVANZADA - REGLAS DE TRAICION
; ==========================================================
(defrule
    (true)
=>
    ; Si un neutral o aliado nos da 1 solo golpe, se vuelve enemigo automaticamente
    (set-strategic-number sn-hits-before-alliance-change 1)
    (disable-self)
)

; ==========================================================
; SINCRONIZACION FAILSAFE: SI ME ODIAS, TE ODIO (GUERRA BILATERAL)
; Sin chat para evitar el bucle de spam al iniciar partidas
; ==========================================================

(defrule
    (players-stance any-computer enemy)
    (not (stance-toward this-any-computer enemy))
=>
    (set-stance this-any-computer enemy)
    (set-goal gl-diplo d-war)
    (set-goal gl-mode m-attack)
)

(defrule
    (players-stance any-human enemy)
    (not (stance-toward this-any-human enemy))
=>
    (set-stance this-any-human enemy)
    (set-goal gl-diplo d-war)
    (set-goal gl-mode m-attack)
)

; ==========================================================
; PROTOCOLO 1: PROPONER ALIANZA
; Taunt 201 = Propongo alianza
; ==========================================================

(defrule
    (timer-triggered t-diplo)
    (goal gl-diplo d-neutral)
    (current-age >= feudal-age)
    (game-time > 600)
    (not (players-stance any-ally ally)) ; Solo si no tenemos aliado ya
    (player-in-game any-computer-neutral)
    (stance-toward this-any-computer-neutral neutral)
=>
    (chat-to-all "Estoy buscando un aliado para gobernar estas tierras...")
    (chat-to-player this-any-computer-neutral "201")
    (disable-timer t-diplo)
    (enable-timer t-diplo 45)
)

; ==========================================================
; PROTOCOLO 2: ACEPTAR ALIANZA DE OTRA IA
; Taunt 204 = Acepto tu alianza
; ==========================================================

(defrule
    (taunt-detected any-computer 201)
    (stance-toward this-any-computer neutral)
    (not (players-stance any-ally ally))
=>
    (acknowledge-taunt this-any-computer 201)
    (chat-to-all "Me parece justo. Acepto formar una alianza bilateral.")
    (chat-to-player this-any-computer "204")
    (set-stance this-any-computer ally)
    (set-goal gl-diplo d-allied)
)

; ==========================================================
; PROTOCOLO 3: CONFIRMAR ALIANZA INICIADA
; La IA que envio el 201 recibe el 204 y oficializa el pacto
; ==========================================================

(defrule
    (taunt-detected any-computer 204)
    (stance-toward this-any-computer neutral)
=>
    (acknowledge-taunt this-any-computer 204)
    (chat-to-all "¡Excelente! El pacto de sangre esta sellado.")
    (set-stance this-any-computer ally)
    (set-goal gl-diplo d-allied)
)

; ==========================================================
; PROTOCOLO 4: ROMPER ALIANZA BILATERALMENTE
; Taunt 202 = Rompo pacto, vuelvo a neutral
; ==========================================================

(defrule
    (timer-triggered t-diplo)
    (goal gl-diplo d-allied)
    (current-age >= imperial-age)
    (soldier-count >= 25)
    (player-in-game any-ally)
    (stance-toward this-any-ally ally)
=>
    (chat-to-all "Las alianzas son efimeras. Nuestro pacto termina aqui. Volvemos a ser neutrales.")
    (chat-to-player this-any-ally "202")
    (set-stance this-any-ally neutral)
    (set-goal gl-diplo d-neutral)
    (disable-timer t-diplo)
    (enable-timer t-diplo 30)
)

(defrule
    (taunt-detected any-computer 202)
    (stance-toward this-any-computer ally)
=>
    (acknowledge-taunt this-any-computer 202)
    (chat-to-all "Asi que rompes nuestra alianza... Muy bien, somos neutrales de nuevo.")
    (set-stance this-any-computer neutral)
    (set-goal gl-diplo d-neutral)
)

; ==========================================================
; PROTOCOLO 5: DECLARAR GUERRA
; Taunt 203 = Guerra
; ==========================================================

(defrule
    (timer-triggered t-diplo)
    (goal gl-diplo d-neutral)
    (current-age >= castle-age)
    (game-time > 1800)
    (player-in-game any-computer-neutral)
    (stance-toward this-any-computer-neutral neutral)
=>
    (chat-to-all "¡La paz es una ilusion! ¡He decidido declarar la guerra!")
    (chat-to-player this-any-computer-neutral "203")
    (set-stance this-any-computer-neutral enemy)
    (set-goal gl-diplo d-war)
    (set-goal gl-mode m-attack)
    (disable-timer t-diplo)
    (enable-timer t-diplo 30)
)

(defrule
    (taunt-detected any-computer 203)
    (not (stance-toward this-any-computer enemy))
=>
    (acknowledge-taunt this-any-computer 203)
    (chat-to-all "¡Acepto el desafio! ¡No tendre piedad en la batalla!")
    (set-stance this-any-computer enemy)
    (set-goal gl-diplo d-war)
    (set-goal gl-mode m-attack)
)

; ==========================================================
; DIPLOMACIA CON JUGADORES HUMANOS
; ==========================================================

; Si el humano propone alianza (201) y somos neutrales
(defrule
    (taunt-detected any-human 201)
    (stance-toward this-any-human neutral)
    (not (players-stance any-ally ally))
=>
    (acknowledge-taunt this-any-human 201)
    (chat-to-all "He aceptado la propuesta de alianza del jugador humano.")
    (set-stance this-any-human ally)
    (set-goal gl-diplo d-allied)
)

; Si el humano rompe la alianza (202)
(defrule
    (taunt-detected any-human 202)
    (stance-toward this-any-human ally)
=>
    (acknowledge-taunt this-any-human 202)
    (chat-to-all "El humano ha roto la alianza. Ahora somos neutrales.")
    (set-stance this-any-human neutral)
    (set-goal gl-diplo d-neutral)
)

; Si el humano declara guerra (203)
(defrule
    (taunt-detected any-human 203)
    (not (stance-toward this-any-human enemy))
=>
    (acknowledge-taunt this-any-human 203)
    (chat-to-all "¡El humano eligio la guerra! ¡Destruyanlo!")
    (set-stance this-any-human enemy)
    (set-goal gl-diplo d-war)
    (set-goal gl-mode m-attack)
)
; ==========================================================
; TAUNTS HUMANOS DE APOYO
; 31 = ataca
; 38 = dame recursos
; ==========================================================

(defrule
    (taunt-detected any-human-ally 31)
    (soldier-count >= 10)
=>
    (acknowledge-taunt this-any-human-ally 31)
    (chat-to-player this-any-human-ally "Atacare pronto.")
    (set-goal gl-mode m-attack)
    (attack-now)
)

(defrule
    (taunt-detected any-human-ally 38)
    (gold-amount >= 300)
=>
    (acknowledge-taunt this-any-human-ally 38)
    (chat-to-player this-any-human-ally "Te envio oro.")
    (tribute-to-player this-any-human-ally gold 100)
)

; ==========================================================
; DIRECTOR DE COMPORTAMIENTO
; Nada de raids basura: desde Castillo exige masa segun pop cap
; ==========================================================

(defrule
    (timer-triggered t-director)
    (town-under-attack)
    (soldier-count < 10)
=>
    (set-goal gl-mode m-defend)
    (set-strategic-number sn-percent-attack-soldiers 60)
    (disable-timer t-director)
    (enable-timer t-director 15)
)

; Ataque normal en Castillo - 75 pop
(defrule
    (timer-triggered t-director)
    (not (goal gl-mode m-all-in))
    (player-in-game any-enemy)
    (current-age == castle-age)
    (population-cap <= 75)
    (soldier-count >= 12)
=>
    (set-goal gl-mode m-attack)
    (set-strategic-number sn-percent-attack-soldiers 85)
    (attack-now)
    (disable-timer t-director)
    (enable-timer t-director 15)
)

; Ataque normal en Castillo - 100 pop
(defrule
    (timer-triggered t-director)
    (not (goal gl-mode m-all-in))
    (player-in-game any-enemy)
    (current-age == castle-age)
    (population-cap > 75)
    (population-cap <= 100)
    (soldier-count >= 16)
=>
    (set-goal gl-mode m-attack)
    (set-strategic-number sn-percent-attack-soldiers 85)
    (attack-now)
    (disable-timer t-director)
    (enable-timer t-director 15)
)

; Ataque normal en Castillo - 150/200 pop
(defrule
    (timer-triggered t-director)
    (not (goal gl-mode m-all-in))
    (player-in-game any-enemy)
    (current-age == castle-age)
    (population-cap > 100)
    (soldier-count >= 20)
=>
    (set-goal gl-mode m-attack)
    (set-strategic-number sn-percent-attack-soldiers 85)
    (attack-now)
    (disable-timer t-director)
    (enable-timer t-director 15)
)

; Ataque normal en Imperial - 75/100 pop
(defrule
    (timer-triggered t-director)
    (not (goal gl-mode m-all-in))
    (player-in-game any-enemy)
    (current-age == imperial-age)
    (population-cap <= 100)
    (soldier-count >= 18)
=>
    (set-goal gl-mode m-attack)
    (set-strategic-number sn-percent-attack-soldiers 90)
    (attack-now)
    (disable-timer t-director)
    (enable-timer t-director 12)
)

; Ataque normal en Imperial - 150/200 pop
(defrule
    (timer-triggered t-director)
    (not (goal gl-mode m-all-in))
    (player-in-game any-enemy)
    (current-age == imperial-age)
    (population-cap > 100)
    (soldier-count >= 26)
=>
    (set-goal gl-mode m-attack)
    (set-strategic-number sn-percent-attack-soldiers 90)
    (attack-now)
    (disable-timer t-director)
    (enable-timer t-director 12)
)

(defrule
    (timer-triggered t-director)
    (not (goal gl-mode m-all-in))
    (soldier-count < 8)
=>
    (set-goal gl-mode m-boom)
    (set-strategic-number sn-percent-attack-soldiers 60)
    (disable-timer t-director)
    (enable-timer t-director 15)
)

(defrule
    (goal gl-mode m-attack)
    (attack-soldier-count == 0)
    (soldier-count >= 10)
=>
    (attack-now)
)

(defrule
    (goal gl-mode m-all-in)
    (attack-soldier-count == 0)
    (soldier-count >= 8)
=>
    (attack-now)
)

(defrule
    (timer-triggered t-director)
=>
    (disable-timer t-director)
    (enable-timer t-director 15)
)

; ==========================================================
; PULSO DE REFUERZOS
; Ataque normal = oleada mas lenta
; All-in = refuerzos mas rapidos
; ==========================================================

(defrule
    (timer-triggered t-pulse)
    (goal gl-mode m-attack)
    (player-in-game any-enemy)
    (defend-soldier-count >= 2)
=>
    (attack-now)
    (disable-timer t-pulse)
    (enable-timer t-pulse 12)
)

(defrule
    (timer-triggered t-pulse)
    (goal gl-mode m-all-in)
    (defend-soldier-count >= 1)
=>
    (attack-now)
    (disable-timer t-pulse)
    (enable-timer t-pulse 8)
)

(defrule
    (timer-triggered t-pulse)
=>
    (disable-timer t-pulse)
    (enable-timer t-pulse 12)
)

; ==========================================================
; MANTENER TIMER DE DIPLOMACIA
; ==========================================================

(defrule
    (timer-triggered t-diplo)
=>
    (disable-timer t-diplo)
    (enable-timer t-diplo 30)
)
