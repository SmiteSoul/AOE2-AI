; ==========================================================
; CONSTRUCCION DEFENSIVA
; ==========================================================

; builders de emergencia
(defrule
    (current-age >= feudal-age)
    (wall-completed-percentage 1 < 100)
=>
    (set-strategic-number sn-percent-civilian-builders 20)
    (set-strategic-number sn-cap-civilian-builders 18)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 2 < 100)
=>
    (set-strategic-number sn-percent-civilian-builders 22)
    (set-strategic-number sn-cap-civilian-builders 20)
)

(defrule
    (current-age == feudal-age)
    (wall-completed-percentage 1 >= 100)
=>
    (set-strategic-number sn-percent-civilian-builders 10)
    (set-strategic-number sn-cap-civilian-builders 10)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 1 >= 100)
    (wall-completed-percentage 2 >= 100)
=>
    (set-strategic-number sn-percent-civilian-builders 10)
    (set-strategic-number sn-cap-civilian-builders 10)
)

; en imperial, con la base ya montada, sube builders para boom militar
(defrule
    (current-age == imperial-age)
    (wall-completed-percentage 1 >= 100)
=>
    (set-strategic-number sn-percent-civilian-builders 14)
    (set-strategic-number sn-cap-civilian-builders 16)
)

; muralla exterior feudal
(defrule
    (current-age == feudal-age)
    (wall-completed-percentage 1 < 100)
    (can-build-wall 1 palisade-wall)
=>
    (build-wall 1 palisade-wall)
)

(defrule
    (current-age == feudal-age)
    (wall-completed-percentage 1 > 15)
    (can-build-gate 1)
=>
    (build-gate 1)
)

; muralla exterior castillo/imperial
(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 1 < 100)
    (can-build-wall 1 stone-wall)
=>
    (build-wall 1 stone-wall)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 1 > 15)
    (can-build-gate 1)
=>
    (build-gate 1)
)

; muralla interior
(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 1 > 45)
    (wall-completed-percentage 2 < 100)
    (can-build-wall 2 stone-wall)
=>
    (build-wall 2 stone-wall)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 2 > 15)
    (can-build-gate 2)
=>
    (build-gate 2)
)

; reforzar brechas
(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 1 < 85)
    (can-build-wall 1 stone-wall)
=>
    (build-wall 1 stone-wall)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 2 < 90)
    (can-build-wall 2 stone-wall)
=>
    (build-wall 2 stone-wall)
)

; torres
(defrule
    (current-age >= feudal-age)
    (wall-completed-percentage 1 > 10)
    (building-type-count-total watch-tower-line < 2)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)

(defrule
    (current-age == castle-age)
    (wall-completed-percentage 1 > 40)
    (building-type-count-total watch-tower-line < 4)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)

