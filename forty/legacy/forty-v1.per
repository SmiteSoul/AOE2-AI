; ==========================================================
; DIRECTOR DEFENSIVO / OFENSIVO
; Dark-Castillo = tortuga
; Imperial = manejo militar estilo semiutils
; ==========================================================

; si nos atacan antes de Imperial, defender y no salir
(defrule
    (timer-triggered t-director)
    (current-age <= castle-age)
    (town-under-attack)
=>
    (set-goal gl-mode m-defend)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-attack-groups 0)
    (disable-timer t-director)
    (enable-timer t-director 15)
)

; dark a castillo: tortuga pura
(defrule
    (timer-triggered t-director)
    (current-age <= castle-age)
    (not (town-under-attack))
=>
    (set-goal gl-mode m-boom)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-attack-groups 0)
    (disable-timer t-director)
    (enable-timer t-director 18)
)

; imperial: si nos golpean y el ejercito es chico, defender
(defrule
    (timer-triggered t-director)
    (current-age == imperial-age)
    (town-under-attack)
    (soldier-count < 10)
=>
    (set-goal gl-mode m-defend)
    (set-strategic-number sn-percent-attack-soldiers 60)
    (disable-timer t-director)
    (enable-timer t-director 15)
)

; ataque imperial estilo semiutils - pop 75/100
(defrule
    (timer-triggered t-director)
    (current-age == imperial-age)
    (player-in-game any-enemy)
    (population-cap <= 100)
    (soldier-count >= 18)
=>
    (set-goal gl-mode m-attack)
    (set-strategic-number sn-number-attack-groups 4)
    (set-strategic-number sn-percent-attack-soldiers 90)
    (attack-now)
    (chat-to-all "Reino Fortificado: la fortaleza abre sus puertas. ¡Marchad!")
    (disable-timer t-director)
    (enable-timer t-director 12)
)

; ataque imperial estilo semiutils - pop 150/200+
(defrule
    (timer-triggered t-director)
    (current-age == imperial-age)
    (player-in-game any-enemy)
    (population-cap > 100)
    (soldier-count >= 26)
=>
    (set-goal gl-mode m-attack)
    (set-strategic-number sn-number-attack-groups 4)
    (set-strategic-number sn-percent-attack-soldiers 90)
    (attack-now)
    (chat-to-all "Reino Fortificado: la fortaleza abre sus puertas. ¡Marchad!")
    (disable-timer t-director)
    (enable-timer t-director 12)
)

; si el ejercito baja demasiado, vuelve a boom imperial
(defrule
    (timer-triggered t-director)
    (current-age == imperial-age)
    (soldier-count < 8)
=>
    (set-goal gl-mode m-boom)
    (set-strategic-number sn-percent-attack-soldiers 60)
    (disable-timer t-director)
    (enable-timer t-director 15)
)

; si el ataque murio pero aun hay ejercito, relanzar
(defrule
    (goal gl-mode m-attack)
    (current-age == imperial-age)
    (attack-soldier-count == 0)
    (soldier-count >= 10)
=>
    (attack-now)
)

(defrule
    (timer-triggered t-director)
=>
    (disable-timer t-director)
    (enable-timer t-director 15)
)

; ==========================================================
; PULSO DE REFUERZOS
; Imperial estilo semiutils
; ==========================================================
(defrule
    (timer-triggered t-pulse)
    (goal gl-mode m-attack)
    (current-age == imperial-age)
    (player-in-game any-enemy)
    (defend-soldier-count >= 2)
=>
    (attack-now)
    (disable-timer t-pulse)
    (enable-timer t-pulse 12)
)

(defrule
    (timer-triggered t-pulse)
=>
    (disable-timer t-pulse)
    (enable-timer t-pulse 12)
)