; ==========================================================
; FORTY.PER
; REINO FORTIFICADO
; IA DEFENSIVA STANDALONE
; UserPatch 1.5 / The Conquerors
; VERSION FINAL:
; - SIN MICRO
; - TORTUGA DARK/FEUDAL/CASTILLO
; - IMPERIAL CON MANEJO MILITAR TIPO SEMIUTILS
; - DROPSITES ADICIONALES
; - CASTILLOS DESBLOQUEADOS
; - BOOM DE PRODUCCION MILITAR EN IMPERIAL
; ==========================================================

; ==========================================================
; GOALS
; ==========================================================
(defconst gl-mode 1)

; ==========================================================
; MODOS
; ==========================================================
(defconst m-boom   0)
(defconst m-defend 1)
(defconst m-attack 2)

; ==========================================================
; TIMERS
; ==========================================================
(defconst t-director 1)
(defconst t-pulse    2)

; ==========================================================
; INIT 1
; ==========================================================
(defrule
    (true)
=>
    (set-goal gl-mode m-boom)
    (enable-timer t-director 18)
    (enable-timer t-pulse 14)
    (disable-self)
)

; ==========================================================
; INIT 2 - exploracion y economia
; ==========================================================
(defrule
    (true)
=>
    (set-strategic-number sn-do-not-scale-for-difficulty-level 1)
    (set-strategic-number sn-build-frequency 1)
    (set-strategic-number sn-initial-exploration-required 0)
    (set-strategic-number sn-percent-exploration-required 0)
    (set-strategic-number sn-percent-civilian-explorers 1)
    (set-strategic-number sn-cap-civilian-explorers 1)
    (set-strategic-number sn-total-number-explorers 1)
    (disable-self)
)

; ==========================================================
; INIT 3 - base compacta
; ==========================================================
(defrule
    (true)
=>
    (set-strategic-number sn-camp-max-distance 20)
    (set-strategic-number sn-mill-max-distance 20)
    (set-strategic-number sn-food-dropsite-distance 8)
    (set-strategic-number sn-wood-dropsite-distance 8)
    (set-strategic-number sn-gold-dropsite-distance 8)
    (set-strategic-number sn-stone-dropsite-distance 8)
    (disable-self)
)

; ==========================================================
; INIT 4 - grupos y defensa base
; ==========================================================
(defrule
    (true)
=>
    (set-strategic-number sn-number-defend-groups 3)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-minimum-attack-group-size 14)
    (set-strategic-number sn-maximum-attack-group-size 22)
    (set-strategic-number sn-group-form-distance 110)
    (disable-self)
)

; ==========================================================
; INIT 5 - comportamiento militar base
; ==========================================================
(defrule
    (true)
=>
    (set-strategic-number sn-scale-minimum-attack-group-size 0)
    (set-strategic-number sn-scale-maximum-attack-group-size 0)
    (set-strategic-number sn-task-ungrouped-soldiers 1)
    (set-strategic-number sn-consecutive-idle-unit-limit 1)
    (set-strategic-number sn-zero-priority-distance 255)
    (set-strategic-number sn-attack-intelligence 0)
    (disable-self)
)

; ==========================================================
; INIT 6 - builders y objetivos
; ==========================================================
(defrule
    (true)
=>
    (set-strategic-number sn-cap-civilian-builders 12)
    (set-strategic-number sn-special-attack-type1 663)
    (set-strategic-number sn-special-attack-influence1 100)
    (set-strategic-number sn-target-evaluation-distance 50)
    (set-strategic-number sn-target-evaluation-continent 160)
    (set-strategic-number sn-target-evaluation-in-progress 15)
    (disable-self)
)

; ==========================================================
; INIT 7 - saludo
; ==========================================================
(defrule
    (true)
=>
    (chat-to-all "Reino Fortificado activo. Base compacta y defensa pesada.")
    (disable-self)
)

; ==========================================================
; INIT EXTRA - ACTIVAR PLANIFICACION DE MURALLAS
; ==========================================================
(defrule
    (true)
=>
    (enable-wall-placement 1)
    (enable-wall-placement 2)
    (disable-self)
)

; ==========================================================
; CRECIMIENTO ORGANICO DE LA BASE
; ==========================================================
(defrule
    (current-age == dark-age)
=>
    (set-strategic-number sn-maximum-town-size 16)
    (set-strategic-number sn-camp-max-distance 20)
    (set-strategic-number sn-mill-max-distance 20)
)

(defrule
    (current-age == feudal-age)
=>
    (set-strategic-number sn-maximum-town-size 24)
    (set-strategic-number sn-camp-max-distance 28)
    (set-strategic-number sn-mill-max-distance 28)
)

(defrule
    (current-age == castle-age)
=>
    (set-strategic-number sn-maximum-town-size 34)
    (set-strategic-number sn-camp-max-distance 36)
    (set-strategic-number sn-mill-max-distance 36)
    (set-strategic-number sn-food-dropsite-distance 9)
    (set-strategic-number sn-wood-dropsite-distance 9)
    (set-strategic-number sn-gold-dropsite-distance 9)
    (set-strategic-number sn-stone-dropsite-distance 9)
)

(defrule
    (current-age == imperial-age)
=>
    (set-strategic-number sn-maximum-town-size 46)
    (set-strategic-number sn-camp-max-distance 45)
    (set-strategic-number sn-mill-max-distance 45)
    (set-strategic-number sn-food-dropsite-distance 10)
    (set-strategic-number sn-wood-dropsite-distance 10)
    (set-strategic-number sn-gold-dropsite-distance 10)
    (set-strategic-number sn-stone-dropsite-distance 10)
)

; ==========================================================
; PERSONALIDAD MILITAR SEMIUTILS EN IMPERIAL
; Dividida para evitar rule too long
; ==========================================================
(defrule
    (current-age == imperial-age)
=>
    (set-strategic-number sn-number-defend-groups 0)
    (set-strategic-number sn-number-attack-groups 4)
    (set-strategic-number sn-minimum-attack-group-size 8)
    (set-strategic-number sn-maximum-attack-group-size 14)
    (set-strategic-number sn-group-form-distance 110)
    (set-strategic-number sn-scale-minimum-attack-group-size 0)
    (disable-self)
)

(defrule
    (current-age == imperial-age)
=>
    (set-strategic-number sn-scale-maximum-attack-group-size 0)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
    (set-strategic-number sn-garrison-rams 1)
    (set-strategic-number sn-enable-patrol-attack 1)
    (set-strategic-number sn-attack-intelligence 0)
    (set-strategic-number sn-special-attack-type1 663)
    (disable-self)
)

(defrule
    (current-age == imperial-age)
=>
    (set-strategic-number sn-special-attack-influence1 180)
    (set-strategic-number sn-target-evaluation-distance 55)
    (set-strategic-number sn-target-evaluation-continent 160)
    (set-strategic-number sn-target-evaluation-siege-weapon 20)
    (set-strategic-number sn-target-evaluation-in-progress 20)
    (disable-self)
)

; ==========================================================
; POSTURA ESTRATEGICA POR EDAD
; ==========================================================
(defrule
    (current-age <= castle-age)
    (not (town-under-attack))
=>
    (set-goal gl-mode m-boom)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-number-defend-groups 3)
)

(defrule
    (current-age == imperial-age)
    (not (goal gl-mode m-attack))
=>
    (set-strategic-number sn-percent-attack-soldiers 60)
    (set-strategic-number sn-number-attack-groups 4)
    (set-strategic-number sn-number-defend-groups 0)
)

; ==========================================================
; REPARTO ECONOMICO
; ==========================================================
(defrule
    (current-age == dark-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 75)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (current-age == feudal-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 48)
    (set-strategic-number sn-wood-gatherer-percentage 32)
    (set-strategic-number sn-gold-gatherer-percentage 10)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

(defrule
    (current-age == castle-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 42)
    (set-strategic-number sn-wood-gatherer-percentage 28)
    (set-strategic-number sn-gold-gatherer-percentage 15)
    (set-strategic-number sn-stone-gatherer-percentage 15)
)

(defrule
    (current-age == imperial-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 35)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 25)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

; ==========================================================
; ALDEANOS
; ==========================================================
(defrule
    (current-age == dark-age)
    (can-train villager)
    (civilian-population < 26)
=>
    (train villager)
)

(defrule
    (current-age == feudal-age)
    (can-train villager)
    (civilian-population < 46)
=>
    (train villager)
)

(defrule
    (current-age == castle-age)
    (can-train villager)
    (civilian-population < 95)
=>
    (train villager)
)

(defrule
    (current-age == imperial-age)
    (can-train villager)
    (civilian-population < 110)
=>
    (train villager)
)

; ==========================================================
; SUBIDAS DE EDAD
; ==========================================================
(defrule
    (current-age == dark-age)
    (can-research feudal-age)
=>
    (research feudal-age)
    (chat-to-all "Reino Fortificado: avanzando a Feudal.")
)

(defrule
    (current-age == feudal-age)
    (can-research castle-age)
=>
