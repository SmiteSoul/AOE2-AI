    (current-age == imperial-age)
    (wall-completed-percentage 2 > 30)
    (building-type-count-total watch-tower-line < 6)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)

; ==========================================================
; CASTILLOS
; Se quita la dependencia fuerte de murallas
; ==========================================================

; primer castillo en castillo/imperial: siempre que pueda
(defrule
    (current-age >= castle-age)
    (stone-amount >= 650)
    (building-type-count-total castle == 0)
    (can-build castle)
=>
    (build castle)
)

; segundo castillo defensivo si hay piedra o presion
(defrule
    (current-age >= castle-age)
    (town-under-attack)
    (stone-amount >= 650)
    (building-type-count-total castle < 2)
    (can-build castle)
=>
    (build castle)
)

(defrule
    (current-age == imperial-age)
    (stone-amount >= 750)
    (building-type-count-total castle < 2)
    (can-build castle)
=>
    (build castle)
)

; boom de castillos en imperial
(defrule
    (current-age == imperial-age)
    (stone-amount >= 850)
    (building-type-count-total castle < 3)
    (player-in-game any-enemy)
    (can-build castle)
=>
    (build-forward castle)
)

(defrule
    (current-age == imperial-age)
    (stone-amount >= 1000)
    (building-type-count-total castle < 4)
    (player-in-game any-enemy)
    (can-build castle)
=>
    (build-forward castle)
)

(defrule
    (current-age == imperial-age)
    (stone-amount >= 1200)
    (building-type-count-total castle < 5)
    (player-in-game any-enemy)
    (can-build castle)
=>
    (build-forward castle)
)

; comprar piedra si esta abierta la defensa o falta para castillos
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle == 0)
    (stone-amount < 650)
    (gold-amount > 900)
    (can-buy-commodity stone)
=>
    (buy-commodity stone)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 1 < 100)
    (stone-amount < 200)
    (gold-amount > 900)
    (can-buy-commodity stone)
=>
    (buy-commodity stone)
)

