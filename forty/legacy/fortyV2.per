; ==========================================================
; FIN BLOQUE 1/10
; EL BLOQUE 2 VA INMEDIATAMENTE DEBAJO
; ==========================================================

; ==========================================================
; semiUtils.per
; BLOQUE 2/10
; INICIALIZACION GENERAL + TIMERS + SN BASE + PUNTOS DUC
; ==========================================================

; ==========================================================
; INIT 1 - ESTADOS BASE
; ==========================================================
(defrule
    (true)
=>
    (set-goal gl-theater th-land-open)
    (set-goal gl-strat-state st-boot)
    (set-goal gl-eco-state ec-balanced)
    (set-goal gl-build-state bd-minimal)
    (set-goal gl-land-combat-state lc-hold)
    (set-goal gl-naval-combat-state nc-ignore)
    (set-goal gl-intel-state in-home-scan)
    (set-goal gl-duc-state duc-idle)
    (disable-self)
)

; ==========================================================
; INIT 2 - DOCTRINAS BASE
; ==========================================================
(defrule
    (true)
=>
    (set-goal gl-doctrine-land dl-generic)
    (set-goal gl-doctrine-naval dn-none)
    (set-goal gl-primary-enemy 0)
    (set-goal gl-primary-front fr-home)
    (set-goal gl-map-openness mo-mixed)
    (set-goal gl-water-presence wp-none)
    (disable-self)
)

; ==========================================================
; INIT 3 - FLAGS ESTRATEGICAS
; ==========================================================
(defrule
    (true)
=>
    (set-goal gl-forward-risk 0)
    (set-goal gl-panic-flag 0)
    (set-goal gl-boom-permit 1)
    (set-goal gl-attack-permit 0)
    (set-goal gl-water-permit 0)
    (set-goal gl-land-permit 1)
    (disable-self)
)

; ==========================================================
; INIT 4 - MODELO ENEMIGO BASE
; ==========================================================
(defrule
    (true)
=>
    (set-goal gl-enemy-land-comp el-unknown)
    (set-goal gl-enemy-naval-comp en-unknown)
    (set-goal gl-enemy-siege-flag 0)
    (set-goal gl-enemy-monk-flag 0)
    (set-goal gl-enemy-castle-flag 0)
    (set-goal gl-enemy-dock-flag 0)
    (disable-self)
)

; ==========================================================
; INIT 5 - FLAGS DE LATE / PUSH
; ==========================================================
(defrule
    (true)
=>
    (set-goal gl-enemy-water-mass 0)
    (set-goal gl-enemy-raiding-flag 0)
    (set-goal gl-enemy-boom-flag 0)
    (set-goal gl-enemy-forward-flag 0)
    (set-goal gl-last-major-decision md-none)
    (set-goal gl-recovery-flag 0)
    (disable-self)
)

; ==========================================================
; INIT 6 - ANCLAS / TRADE / TARGETS
; ==========================================================
(defrule
    (true)
=>
    (set-goal gl-anchor-ready-land 0)
    (set-goal gl-anchor-ready-water 0)
    (set-goal gl-trade-permit 0)
    (set-goal gl-market-mode mm-idle)
    (set-goal gl-front-creep-mode fc-off)
    (set-goal gl-target-class-land tg-land-none)
    (set-goal gl-target-class-water tg-water-none)
    (disable-self)
)

; ==========================================================
; INIT 7 - SCRATCH / SCORE ENGINE
; ==========================================================
(defrule
    (true)
=>
    (set-goal gl-score-a 0)
    (set-goal gl-score-b 0)
    (set-goal gl-score-c 0)
    (set-goal gl-score-d 0)
    (set-goal gl-best-score 0)
    (set-goal gl-best-choice 0)
    (disable-self)
)

(defrule
    (true)
=>
    (set-goal gl-alt-score 0)
    (set-goal gl-alt-choice 0)
    (set-goal gl-search-main 0)
    (set-goal gl-search-a 0)
    (set-goal gl-search-b 0)
    (set-goal gl-search-c 0)
    (disable-self)
)

(defrule
    (true)
=>
    (set-goal gl-hyst-a 0)
    (set-goal gl-hyst-b 0)
    (set-goal gl-hyst-c 0)
    (set-goal gl-watch-a 0)
    (set-goal gl-watch-b 0)
    (set-goal gl-watch-c 0)
    (set-goal gl-debug-mode 0)
    (disable-self)
)

; ==========================================================
; INIT 8 - PUNTOS BASE PARA DUC
; ==========================================================
(defrule
    (true)
=>
    (up-get-point position-self gl-home-x)
    (disable-self)
)

(defrule
    (true)
=>
    (up-get-point position-self gl-anchor-x)
    (disable-self)
)

(defrule
    (true)
=>
    (up-get-point position-self gl-fallback-x)
    (disable-self)
)

(defrule
    (true)
=>
    (up-get-point position-self gl-temp-x)
    (disable-self)
)

; ==========================================================
; INIT 9 - TIMERS
; ==========================================================
(defrule
    (true)
=>
    (enable-timer t-master 14)
    (enable-timer t-eco-fast 5)
    (enable-timer t-eco-slow 11)
    (enable-timer t-build 7)
    (enable-timer t-train-land 4)
    (enable-timer t-train-naval 4)
    (disable-self)
)

(defrule
    (true)
=>
    (enable-timer t-tech 9)
    (enable-timer t-intel 18)
    (enable-timer t-land-combat 6)
    (enable-timer t-naval-combat 6)
    (enable-timer t-wall-defense 3)
    (disable-self)
)

(defrule
    (true)
=>
    (enable-timer t-duc-sortie 3)
    (enable-timer t-duc-anchor 4)
    (enable-timer t-duc-naval 4)
    (enable-timer t-market-trade 10)
    (enable-timer t-watchdog 15)
    (disable-self)
)

; ==========================================================
; INIT 10 - SN BASE DE ESCALADO Y RITMO
; ==========================================================
(defrule
    (true)
=>
    (set-strategic-number sn-do-not-scale-for-difficulty-level 1)
    (set-strategic-number sn-build-frequency 1)
    (set-strategic-number sn-initial-exploration-required 0)
    (set-strategic-number sn-percent-exploration-required 0)
    (set-strategic-number sn-percent-civilian-explorers 1)
    (set-strategic-number sn-cap-civilian-explorers 1)
    (disable-self)
)

(defrule
    (true)
=>
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-consecutive-idle-unit-limit 1)
    (set-strategic-number sn-zero-priority-distance 255)
    (set-strategic-number sn-attack-intelligence 0)
    (set-strategic-number sn-scale-minimum-attack-group-size 0)
    (set-strategic-number sn-scale-maximum-attack-group-size 0)
    (disable-self)
)

; ==========================================================
; INIT 11 - SN BASE DE DEFENSA / ATAQUE
; ==========================================================
(defrule
    (true)
=>
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-minimum-attack-group-size 8)
    (set-strategic-number sn-maximum-attack-group-size 14)
    (set-strategic-number sn-group-form-distance 100)
    (disable-self)
)

(defrule
    (true)
=>
    (set-strategic-number sn-task-ungrouped-soldiers 1)
    (set-strategic-number sn-special-attack-type1 663)
    (set-strategic-number sn-special-attack-influence1 100)
    (set-strategic-number sn-target-evaluation-distance 50)
    (set-strategic-number sn-target-evaluation-continent 160)
    (set-strategic-number sn-target-evaluation-in-progress 15)
    (disable-self)
)

; ==========================================================
; INIT 12 - SN BASE ECONOMICOS
; ==========================================================
(defrule
    (true)
=>
    (set-strategic-number sn-cap-civilian-builders 8)
    (set-strategic-number sn-percent-civilian-builders 8)
    (set-strategic-number sn-camp-max-distance 24)
    (set-strategic-number sn-mill-max-distance 22)
    (set-strategic-number sn-food-dropsite-distance 8)
    (set-strategic-number sn-wood-dropsite-distance 8)
    (disable-self)
)

(defrule
    (true)
=>
    (set-strategic-number sn-gold-dropsite-distance 8)
    (set-strategic-number sn-stone-dropsite-distance 8)
    (set-strategic-number sn-percent-civilian-gatherers 100)
    (set-strategic-number sn-food-gatherer-percentage 70)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (disable-self)
)

(defrule
    (true)
=>
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (disable-self)
)

; ==========================================================
; INIT 13 - SN PARA AGUA / NAVAL
; Conservador: no invertir todavia hasta clasificar teatro
; ==========================================================
(defrule
    (true)
=>
    (set-strategic-number sn-number-explore-groups 1)
    (disable-self)
)

; ==========================================================
; INIT 14 - WALL PLACEMENT HABILITADO
; ==========================================================
(defrule
    (true)
=>
    (enable-wall-placement 1)
    (enable-wall-placement 2)
    (disable-self)
)

; ==========================================================
; INIT 15 - DETECCION INICIAL CONSERVADORA DEL TEATRO
; Por defecto se arranca como land-open y luego se corrige
; en bloques posteriores por scouting e infraestructura.
; ==========================================================
(defrule
    (current-age == dark-age)
=>
    (set-goal gl-theater th-land-open)
    (set-goal gl-water-presence wp-none)
    (set-goal gl-doctrine-naval dn-none)
    (disable-self)
)

; ==========================================================
; INIT 16 - BOOT A OPENING
; ==========================================================
(defrule
    (goal gl-strat-state st-boot)
=>
    (set-goal gl-strat-state st-opening)
    (set-goal gl-eco-state ec-balanced)
    (set-goal gl-build-state bd-minimal)
    (set-goal gl-land-combat-state lc-hold)
    (set-goal gl-naval-combat-state nc-ignore)
    (set-goal gl-last-major-decision md-eco)
    (disable-self)
)

; ==========================================================
; INIT 17 - SALUDO
; ==========================================================
(defrule
    (true)
=>
    (chat-to-all "semiUtils activo. Analizando mapa y preparando apertura generalista.")
    (disable-self)
)

; ==========================================================
; INIT 18 - HOME/FALLBACK RESETEABLES SI HAY TC
; ==========================================================
(defrule
    (building-type-count-total town-center > 0)
=>
    (up-get-point position-self gl-home-x)
    (up-get-point position-self gl-fallback-x)
    (disable-self)
)

; ==========================================================
; INIT 19 - DEFENSA NAVAL DESACTIVADA DE INICIO
; Se activa mas adelante si el teatro se corrige a hybrid/water.
; ==========================================================
(defrule
    (goal gl-theater th-land-open)
=>
    (set-goal gl-water-permit 0)
    (set-goal gl-naval-combat-state nc-ignore)
    (disable-self)
)

; ==========================================================
; INIT 20 - ANCLA TERRESTRE TEMPORAL = CASA
; ==========================================================
(defrule
    (true)
=>
    (up-get-point position-self gl-anchor-x)
    (set-goal gl-anchor-ready-land 0)
    (set-goal gl-anchor-ready-water 0)
    (disable-self)
)

; ==========================================================
; FIN BLOQUE 2/10
; EL BLOQUE 3 VA INMEDIATAMENTE DEBAJO
; ==========================================================

; ==========================================================
; semiUtils.per
; BLOQUE 3/10
; CRECIMIENTO ORGANICO + CLASIFICACION DE TEATRO
; + TRANSICIONES MACRO + ECONOMIA BASE GENERALISTA
; ==========================================================

; ==========================================================
; CRECIMIENTO ORGANICO DE LA BASE
; ==========================================================
(defrule
    (current-age == dark-age)
=>
    (set-strategic-number sn-maximum-town-size 16)
    (set-strategic-number sn-camp-max-distance 22)
    (set-strategic-number sn-mill-max-distance 20)
    (set-strategic-number sn-food-dropsite-distance 8)
    (set-strategic-number sn-wood-dropsite-distance 8)
)

(defrule
    (current-age == feudal-age)
=>
    (set-strategic-number sn-maximum-town-size 24)
    (set-strategic-number sn-camp-max-distance 28)
    (set-strategic-number sn-mill-max-distance 26)
    (set-strategic-number sn-food-dropsite-distance 8)
    (set-strategic-number sn-wood-dropsite-distance 8)
)

(defrule
    (current-age == castle-age)
=>
    (set-strategic-number sn-maximum-town-size 34)
    (set-strategic-number sn-camp-max-distance 36)
    (set-strategic-number sn-mill-max-distance 34)
    (set-strategic-number sn-food-dropsite-distance 9)
    (set-strategic-number sn-wood-dropsite-distance 9)
)

(defrule
    (current-age == imperial-age)
=>
    (set-strategic-number sn-maximum-town-size 46)
    (set-strategic-number sn-camp-max-distance 44)
    (set-strategic-number sn-mill-max-distance 42)
    (set-strategic-number sn-food-dropsite-distance 10)
    (set-strategic-number sn-wood-dropsite-distance 10)
)

(defrule
    (current-age >= castle-age)
=>
    (set-strategic-number sn-gold-dropsite-distance 9)
    (set-strategic-number sn-stone-dropsite-distance 9)
)

(defrule
    (current-age == imperial-age)
=>
    (set-strategic-number sn-gold-dropsite-distance 10)
    (set-strategic-number sn-stone-dropsite-distance 10)
)

; ==========================================================
; CLASIFICACION CONSERVADORA DEL TEATRO
; ==========================================================

; Si no hay docks ni posibilidad naval visible, seguir land
(defrule
    (current-age == dark-age)
    (building-type-count-total dock == 0)
    (not (can-build dock))
=>
    (set-goal gl-theater th-land-open)
    (set-goal gl-water-presence wp-none)
    (set-goal gl-water-permit 0)
    (set-goal gl-doctrine-naval dn-none)
)

; Si se puede construir dock muy temprano, marcar hybrid
(defrule
    (current-age <= feudal-age)
    (can-build dock)
    (building-type-count-total dock == 0)
=>
    (set-goal gl-theater th-hybrid)
    (set-goal gl-water-presence wp-shoreline)
    (set-goal gl-water-permit 1)
)

; Si ya tenemos dock, minimo hybrid
(defrule
    (building-type-count-total dock > 0)
=>
    (set-goal gl-theater th-hybrid)
    (set-goal gl-water-presence wp-shoreline)
    (set-goal gl-water-permit 1)
)

; Si ambos bandos tienen dock, escalar hacia water/hybrid fuerte
(defrule
    (building-type-count-total dock > 0)
    (players-building-type-count any-enemy dock > 0)
=>
    (set-goal gl-theater th-water)
    (set-goal gl-water-presence wp-full)
    (set-goal gl-water-permit 1)
    (set-goal gl-enemy-dock-flag 1)
)

; Si tenemos flota pesquera relevante, ya no ignorar agua
(defrule
    (unit-type-count-total fishing-ship > 2)
=>
    (set-goal gl-water-presence wp-shoreline)
    (set-goal gl-water-permit 1)
)

; Si tenemos produccion naval fuerte, teatro naval real
(defrule
    (building-type-count-total dock > 1)
=>
    (set-goal gl-theater th-water)
    (set-goal gl-water-presence wp-full)
    (set-goal gl-water-permit 1)
)

; Si estamos full water/hybrid, no cortar tierra
(defrule
    (goal gl-theater th-hybrid)
=>
    (set-goal gl-land-permit 1)
)

(defrule
    (goal gl-theater th-water)
=>
    (set-goal gl-land-permit 1)
)

; ==========================================================
; APERTURA DEL MAPA (HEURISTICA SUAVE)
; ==========================================================

; si el plan de murallas progresa, tratarlo como mas cerrado
(defrule
    (wall-completed-percentage 1 > 35)
=>
    (set-goal gl-map-openness mo-mixed)
)

(defrule
    (wall-completed-percentage 1 > 75)
=>
    (set-goal gl-map-openness mo-closed)
)

; si aun no hay muralla y estamos expuestos, asumir abierto
(defrule
    (current-age <= feudal-age)
    (wall-completed-percentage 1 < 10)
=>
    (set-goal gl-map-openness mo-open)
)

; ==========================================================
; FORWARD RISK / PANICO TEMPRANO
; ==========================================================
(defrule
    (current-age <= feudal-age)
    (town-under-attack)
=>
    (set-goal gl-panic-flag 1)
    (set-goal gl-forward-risk 2)
)

(defrule
    (current-age >= castle-age)
    (town-under-attack)
=>
    (set-goal gl-forward-risk 2)
)

(defrule
    (not (town-under-attack))
    (goal gl-panic-flag 1)
    (current-age >= feudal-age)
=>
    (set-goal gl-panic-flag 0)
)

; ==========================================================
; PERMISOS GENERALES POR TEATRO
; ==========================================================

; land puro: eco/ataque terrestre, nada naval
(defrule
    (goal gl-theater th-land-open)
=>
    (set-goal gl-land-permit 1)
    (set-goal gl-water-permit 0)
)

(defrule
    (goal gl-theater th-land-closed)
=>
    (set-goal gl-land-permit 1)
    (set-goal gl-water-permit 0)
)

; hybrid: ambos habilitados
(defrule
    (goal gl-theater th-hybrid)
=>
    (set-goal gl-land-permit 1)
    (set-goal gl-water-permit 1)
)

; water: mantener ambos, pero permitir sesgo naval
(defrule
    (goal gl-theater th-water)
=>
    (set-goal gl-land-permit 1)
    (set-goal gl-water-permit 1)
)

; ==========================================================
; TRANSICIONES MACRO POR EDAD Y PRESION
; ==========================================================

; dark: apertura
(defrule
    (current-age == dark-age)
=>
    (set-goal gl-strat-state st-opening)
    (set-goal gl-boom-permit 1)
    (set-goal gl-attack-permit 0)
    (set-goal gl-land-combat-state lc-hold)
)

; feudal bajo presion
(defrule
    (current-age == feudal-age)
    (town-under-attack)
=>
    (set-goal gl-strat-state st-feudal-defense)
    (set-goal gl-boom-permit 1)
    (set-goal gl-attack-permit 0)
    (set-goal gl-land-combat-state lc-local-defense)
)

; feudal estable: puede presionar un poco en land abierto
(defrule
    (current-age == feudal-age)
    (not (town-under-attack))
    (goal gl-theater th-land-open)
    (soldier-count >= 8)
=>
    (set-goal gl-strat-state st-feudal-pressure)
    (set-goal gl-boom-permit 1)
    (set-goal gl-attack-permit 1)
    (set-goal gl-land-combat-state lc-contain)
)

; feudal estable en cerrado/hybrid: seguir defensivo
(defrule
    (current-age == feudal-age)
    (not (town-under-attack))
    (goal gl-theater th-hybrid)
=>
    (set-goal gl-strat-state st-feudal-defense)
    (set-goal gl-boom-permit 1)
    (set-goal gl-attack-permit 0)
)

(defrule
    (current-age == feudal-age)
    (not (town-under-attack))
    (goal gl-map-openness mo-closed)
=>
    (set-goal gl-strat-state st-feudal-defense)
    (set-goal gl-boom-permit 1)
    (set-goal gl-attack-permit 0)
)

; castillo estable: boom
(defrule
    (current-age == castle-age)
    (not (town-under-attack))
=>
    (set-goal gl-strat-state st-castle-boom)
    (set-goal gl-boom-permit 1)
    (set-goal gl-attack-permit 0)
    (set-goal gl-land-combat-state lc-hold)
)

; castillo en guerra
(defrule
    (current-age == castle-age)
    (town-under-attack)
=>
    (set-goal gl-strat-state st-castle-war)
    (set-goal gl-boom-permit 1)
    (set-goal gl-attack-permit 0)
    (set-goal gl-land-combat-state lc-local-defense)
)

; castillo con ejercito ya suficiente: contener
(defrule
    (current-age == castle-age)
    (not (town-under-attack))
    (soldier-count >= 18)
    (goal gl-theater th-land-open)
=>
    (set-goal gl-strat-state st-castle-war)
    (set-goal gl-attack-permit 1)
    (set-goal gl-land-combat-state lc-contain)
)

; imperial inicial = preparacion
(defrule
    (current-age == imperial-age)
    (soldier-count < 30)
=>
    (set-goal gl-strat-state st-imp-prep)
    (set-goal gl-boom-permit 1)
    (set-goal gl-attack-permit 0)
)

; imperial con masa = control
(defrule
    (current-age == imperial-age)
    (soldier-count >= 30)
=>
    (set-goal gl-strat-state st-imp-control)
    (set-goal gl-boom-permit 1)
    (set-goal gl-attack-permit 1)
)

; imperial con asedio = push
(defrule
    (current-age == imperial-age)
    (unit-type-count-total trebuchet >= 2)
    (soldier-count >= 34)
=>
    (set-goal gl-strat-state st-imp-push)
    (set-goal gl-boom-permit 1)
    (set-goal gl-attack-permit 1)
    (set-goal gl-land-combat-state lc-push)
)

(defrule
    (current-age == imperial-age)
    (unit-type-count-total bombard-cannon >= 2)
    (soldier-count >= 34)
=>
    (set-goal gl-strat-state st-imp-push)
    (set-goal gl-boom-permit 1)
    (set-goal gl-attack-permit 1)
    (set-goal gl-land-combat-state lc-push)
)

; recovery
(defrule
    (current-age >= castle-age)
    (soldier-count < 8)
=>
    (set-goal gl-recovery-flag 1)
    (set-goal gl-strat-state st-recovery)
    (set-goal gl-attack-permit 0)
    (set-goal gl-land-combat-state lc-regroup)
)

(defrule
    (current-age >= castle-age)
    (soldier-count >= 14)
    (goal gl-recovery-flag 1)
=>
    (set-goal gl-recovery-flag 0)
)

; ==========================================================
; POSTURA NAVAL BASE
; ==========================================================

; sin agua: ignorar naval
(defrule
    (goal gl-water-presence wp-none)
=>
    (set-goal gl-naval-combat-state nc-ignore)
)

; con costa y fish propia: defender fish
(defrule
    (goal gl-water-presence wp-shoreline)
    (unit-type-count-total fishing-ship > 0)
=>
    (set-goal gl-naval-combat-state nc-defend-fish)
)

; con docks de ambos bandos: pelear por agua
(defrule
    (building-type-count-total dock > 0)
    (players-building-type-count any-enemy dock > 0)
=>
    (set-goal gl-naval-combat-state nc-contest-water)
)

; imperial naval: bloqueo si ya hay masa y agua plena
(defrule
    (current-age == imperial-age)
    (goal gl-theater th-water)
    (building-type-count-total dock >= 2)
=>
    (set-goal gl-naval-combat-state nc-blockade)
)

; ==========================================================
; ECONOMIA BASE GENERALISTA POR EDAD - LAND
; ==========================================================

(defrule
    (goal gl-theater th-land-open)
    (current-age == dark-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 72)
    (set-strategic-number sn-wood-gatherer-percentage 28)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (goal gl-theater th-land-open)
    (current-age == feudal-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 48)
    (set-strategic-number sn-wood-gatherer-percentage 34)
    (set-strategic-number sn-gold-gatherer-percentage 12)
    (set-strategic-number sn-stone-gatherer-percentage 6)
)

(defrule
    (goal gl-theater th-land-open)
    (current-age == castle-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 40)
    (set-strategic-number sn-wood-gatherer-percentage 28)
    (set-strategic-number sn-gold-gatherer-percentage 22)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

(defrule
    (goal gl-theater th-land-open)
    (current-age == imperial-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 33)
    (set-strategic-number sn-wood-gatherer-percentage 24)
    (set-strategic-number sn-gold-gatherer-percentage 28)
    (set-strategic-number sn-stone-gatherer-percentage 15)
)

; ==========================================================
; ECONOMIA BASE GENERALISTA - CLOSED LAND
; ==========================================================

(defrule
    (goal gl-map-openness mo-closed)
    (current-age == feudal-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 50)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 8)
    (set-strategic-number sn-stone-gatherer-percentage 12)
)

(defrule
    (goal gl-map-openness mo-closed)
    (current-age == castle-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 40)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 18)
    (set-strategic-number sn-stone-gatherer-percentage 17)
)

; ==========================================================
; ECONOMIA BASE GENERALISTA - HYBRID / WATER
; ==========================================================

(defrule
    (goal gl-theater th-hybrid)
    (current-age == dark-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 62)
    (set-strategic-number sn-wood-gatherer-percentage 38)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (goal gl-theater th-hybrid)
    (current-age == feudal-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 42)
    (set-strategic-number sn-wood-gatherer-percentage 38)
    (set-strategic-number sn-gold-gatherer-percentage 15)
    (set-strategic-number sn-stone-gatherer-percentage 5)
)

(defrule
    (goal gl-theater th-hybrid)
    (current-age == castle-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 34)
    (set-strategic-number sn-gold-gatherer-percentage 22)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

(defrule
    (goal gl-theater th-water)
    (current-age == dark-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 58)
    (set-strategic-number sn-wood-gatherer-percentage 42)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
)

(defrule
    (goal gl-theater th-water)
    (current-age == feudal-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 35)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 20)
    (set-strategic-number sn-stone-gatherer-percentage 5)
)

(defrule
    (goal gl-theater th-water)
    (current-age == castle-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 30)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 25)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

(defrule
    (goal gl-theater th-water)
    (current-age == imperial-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 26)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 30)
    (set-strategic-number sn-stone-gatherer-percentage 14)
)

; ==========================================================
; AJUSTE DE BUILD STATE SEGUN FASE
; ==========================================================

(defrule
    (goal gl-strat-state st-opening)
=>
    (set-goal gl-build-state bd-minimal)
)

(defrule
    (goal gl-strat-state st-feudal-defense)
=>
    (set-goal gl-build-state bd-defense-core)
)

(defrule
    (goal gl-strat-state st-feudal-pressure)
=>
    (set-goal gl-build-state bd-land-production)
)

(defrule
    (goal gl-strat-state st-castle-boom)
=>
    (set-goal gl-build-state bd-eco-expand)
)

(defrule
    (goal gl-strat-state st-castle-war)
=>
    (set-goal gl-build-state bd-defense-core)
)

(defrule
    (goal gl-strat-state st-imp-prep)
=>
    (set-goal gl-build-state bd-land-production)
)

(defrule
    (goal gl-strat-state st-imp-control)
=>
    (set-goal gl-build-state bd-castle-network)
)

(defrule
    (goal gl-strat-state st-imp-push)
=>
    (set-goal gl-build-state bd-front-creep)
)

(defrule
    (goal gl-theater th-water)
    (current-age >= feudal-age)
=>
    (set-goal gl-build-state bd-naval-production)
)

; ==========================================================
; FIN BLOQUE 3/10
; EL BLOQUE 4 VA INMEDIATAMENTE DEBAJO
; ==========================================================

; ==========================================================
; semiUtils.per
; BLOQUE 4/10
; ALDEANOS + EDIFICIOS BASE + EXPANSION CIVIL/MILITAR
; ==========================================================

; ==========================================================
; BOOM DE ALDEANOS
; ==========================================================
(defrule
    (current-age == dark-age)
    (can-train villager)
    (civilian-population < 27)
=>
    (train villager)
)

(defrule
    (current-age == feudal-age)
    (can-train villager)
    (civilian-population < 48)
=>
    (train villager)
)

(defrule
    (current-age == castle-age)
    (can-train villager)
    (civilian-population < 96)
=>
    (train villager)
)

(defrule
    (current-age == imperial-age)
    (can-train villager)
    (civilian-population < 118)
=>
    (train villager)
)

; en agua/hibrido permitir eco ligeramente mayor
(defrule
    (goal gl-water-presence wp-shoreline)
    (current-age == castle-age)
    (can-train villager)
    (civilian-population < 102)
=>
    (train villager)
)

(defrule
    (goal gl-water-presence wp-full)
    (current-age == imperial-age)
    (can-train villager)
    (civilian-population < 124)
=>
    (train villager)
)

; ==========================================================
; CASAS
; ==========================================================
(defrule
    (housing-headroom < 6)
    (can-build house)
=>
    (build house)
)

(defrule
    (housing-headroom < 10)
    (current-age >= castle-age)
    (can-build house)
=>
    (build house)
)

; ==========================================================
; DROPSITES BASE
; ==========================================================
(defrule
    (building-type-count-total lumber-camp == 0)
    (can-build lumber-camp)
=>
    (build lumber-camp)
)

(defrule
    (building-type-count-total mill == 0)
    (can-build mill)
=>
    (build mill)
)

(defrule
    (building-type-count-total mining-camp == 0)
    (current-age >= feudal-age)
    (can-build mining-camp)
=>
    (build mining-camp)
)

; piedra temprana para mapas cerrados o panico
(defrule
    (current-age == dark-age)
    (civilian-population >= 18)
    (goal gl-map-openness mo-closed)
    (building-type-count-total mining-camp == 0)
    (can-build mining-camp)
=>
    (build mining-camp)
)

(defrule
    (current-age == dark-age)
    (civilian-population >= 18)
    (goal gl-panic-flag 1)
