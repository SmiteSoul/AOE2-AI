(defrule
    (goal gl-water-permit 0)
=>
    (set-goal gl-doctrine-naval dn-none)
)

(defrule
    (goal gl-water-permit 1)
    (goal gl-enemy-naval-comp en-unknown)
=>
    (set-goal gl-doctrine-naval dn-galley-control)
)

(defrule
    (goal gl-water-permit 1)
    (goal gl-enemy-naval-comp en-galley)
=>
