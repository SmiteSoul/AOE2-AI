(defrule
    (timer-triggered t-master)
    (goal gl-strat-state st-castle-war)
    (soldier-count < 16)
=>
    (set-goal gl-attack-permit 0)
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
)

; ==========================================================
; DIRECTOR MACRO - IMPERIAL
; ==========================================================

(defrule
    (timer-triggered t-master)
    (goal gl-strat-state st-imp-prep)
=>
    (set-goal gl-attack-permit 0)
    (set-strategic-number sn-number-defend-groups 2)
    (set-strategic-number sn-number-attack-groups 0)
    (set-strategic-number sn-percent-attack-soldiers 0)
    (set-strategic-number sn-minimum-attack-group-size 8)
    (set-strategic-number sn-maximum-attack-group-size 14)
    (set-strategic-number sn-group-form-distance 100)
    (set-strategic-number sn-task-ungrouped-soldiers 1)
)

(defrule
    (timer-triggered t-master)
    (goal gl-strat-state st-imp-control)
    (soldier-count >= 26)
=>
    (set-goal gl-attack-permit 1)
    (set-strategic-number sn-number-defend-groups 1)
    (set-strategic-number sn-number-attack-groups 3)
    (set-strategic-number sn-percent-attack-soldiers 75)
    (set-strategic-number sn-minimum-attack-group-size 10)
    (set-strategic-number sn-maximum-attack-group-size 16)
    (set-strategic-number sn-group-form-distance 110)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
    (attack-now)
)

(defrule
    (timer-triggered t-master)
    (goal gl-strat-state st-imp-push)
    (population-cap <= 100)
    (soldier-count >= 28)
=>
    (set-goal gl-attack-permit 1)
    (set-strategic-number sn-number-defend-groups 0)
    (set-strategic-number sn-number-attack-groups 4)
    (set-strategic-number sn-percent-attack-soldiers 90)
    (set-strategic-number sn-minimum-attack-group-size 10)
    (set-strategic-number sn-maximum-attack-group-size 18)
    (set-strategic-number sn-group-form-distance 115)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
    (attack-now)
)

(defrule
    (timer-triggered t-master)
    (goal gl-strat-state st-imp-push)
    (population-cap > 100)
    (soldier-count >= 36)
=>
    (set-goal gl-attack-permit 1)
    (set-strategic-number sn-number-defend-groups 0)
    (set-strategic-number sn-number-attack-groups 5)
    (set-strategic-number sn-percent-attack-soldiers 95)
    (set-strategic-number sn-minimum-attack-group-size 12)
    (set-strategic-number sn-maximum-attack-group-size 20)
    (set-strategic-number sn-group-form-distance 120)
    (set-strategic-number sn-task-ungrouped-soldiers 0)
    (attack-now)
)

; ==========================================================
; RELANZAMIENTO DE ATAQUES TERRESTRES
; ==========================================================

(defrule
    (goal gl-attack-permit 1)
    (attack-soldier-count == 0)
    (soldier-count >= 12)
    (current-age >= feudal-age)
=>
    (attack-now)
)

(defrule
    (goal gl-strat-state st-imp-push)
    (attack-soldier-count == 0)
    (soldier-count >= 18)
=>
    (attack-now)
)

; ==========================================================
; MOTOR DE COMBATE TERRESTRE - DEFENSA
; ==========================================================

(defrule
    (timer-triggered t-land-combat)
    (town-under-attack)
    (soldier-count < 10)
=>
    (set-goal gl-land-combat-state lc-local-defense)
    (set-goal gl-attack-permit 0)
    (set-goal gl-last-major-decision md-defend)
)

(defrule
    (timer-triggered t-land-combat)
    (town-under-attack)
    (goal gl-enemy-siege-flag 1)
=>
    (set-goal gl-land-combat-state lc-local-defense)
    (set-goal gl-duc-state duc-anti-siege)
    (set-goal gl-last-major-decision md-defend)
)

(defrule
    (timer-triggered t-land-combat)
    (town-under-attack)
    (goal gl-enemy-raiding-flag 1)
=>
    (set-goal gl-land-combat-state lc-local-defense)
    (set-goal gl-last-major-decision md-defend)
)

(defrule
    (timer-triggered t-land-combat)
    (goal gl-land-combat-state lc-local-defense)
    (not (town-under-attack))
    (soldier-count < 10)
=>
    (set-goal gl-land-combat-state lc-hold)
)

; ==========================================================
; MOTOR DE COMBATE TERRESTRE - RAID / CONTAIN
; ==========================================================

(defrule
    (timer-triggered t-land-combat)
    (goal gl-enemy-boom-flag 1)
    (goal gl-map-openness mo-open)
    (goal gl-attack-permit 1)
    (soldier-count >= 12)
    (current-age >= castle-age)
=>
    (set-goal gl-land-combat-state lc-raid)
    (set-goal gl-last-major-decision md-attack)
)

(defrule
    (timer-triggered t-land-combat)
    (goal gl-attack-permit 1)
    (soldier-count >= 14)
    (current-age >= castle-age)
    (goal gl-land-combat-state lc-hold)
=>
    (set-goal gl-land-combat-state lc-contain)
)

(defrule
    (timer-triggered t-land-combat)
    (goal gl-land-combat-state lc-raid)
    (soldier-count >= 14)
=>
    (attack-now)
)

(defrule
    (timer-triggered t-land-combat)
    (goal gl-land-combat-state lc-contain)
    (soldier-count >= 16)
=>
    (attack-now)
)

; ==========================================================
; MOTOR DE COMBATE TERRESTRE - PUSH / REGROUP / RETREAT
; ==========================================================

(defrule
    (timer-triggered t-land-combat)
    (current-age == imperial-age)
    (goal gl-attack-permit 1)
    (soldier-count >= 28)
    (unit-type-count-total trebuchet >= 2)
=>
    (set-goal gl-land-combat-state lc-push)
    (set-goal gl-anchor-ready-land 1)
    (set-goal gl-last-major-decision md-attack)
)

(defrule
    (timer-triggered t-land-combat)
    (current-age == imperial-age)
    (goal gl-attack-permit 1)
    (soldier-count >= 28)
    (unit-type-count-total bombard-cannon >= 2)
=>
    (set-goal gl-land-combat-state lc-push)
    (set-goal gl-anchor-ready-land 1)
    (set-goal gl-last-major-decision md-attack)
)

(defrule
    (timer-triggered t-land-combat)
    (goal gl-land-combat-state lc-push)
    (soldier-count < 14)
=>
    (set-goal gl-land-combat-state lc-regroup)
    (set-goal gl-attack-permit 0)
    (set-goal gl-anchor-ready-land 0)
    (set-goal gl-last-major-decision md-regroup)
)

(defrule
    (timer-triggered t-land-combat)
    (goal gl-land-combat-state lc-push)
    (unit-type-count-total trebuchet < 1)
    (unit-type-count-total bombard-cannon < 1)
    (current-age == imperial-age)
=>
    (set-goal gl-land-combat-state lc-regroup)
    (set-goal gl-anchor-ready-land 0)
    (set-goal gl-last-major-decision md-regroup)
)

(defrule
    (timer-triggered t-land-combat)
    (goal gl-land-combat-state lc-regroup)
    (soldier-count >= 20)
    (goal gl-attack-permit 1)
=>
    (set-goal gl-land-combat-state lc-contain)
)

(defrule
    (timer-triggered t-land-combat)
    (goal gl-land-combat-state lc-regroup)
    (town-under-attack)
=>
    (set-goal gl-land-combat-state lc-retreat)
)

(defrule
    (timer-triggered t-land-combat)
    (goal gl-land-combat-state lc-retreat)
    (not (town-under-attack))
=>
    (set-goal gl-land-combat-state lc-hold)
)

; ==========================================================
; REGLAS DE PERMISO DE ATAQUE TERRESTRE
; ==========================================================

(defrule
    (goal gl-land-combat-state lc-hold)
=>
    (set-goal gl-attack-permit 0)
)

(defrule
    (goal gl-land-combat-state lc-local-defense)
=>
    (set-goal gl-attack-permit 0)
)

(defrule
    (goal gl-land-combat-state lc-regroup)
=>
    (set-goal gl-attack-permit 0)
)

(defrule
    (goal gl-land-combat-state lc-retreat)
=>
    (set-goal gl-attack-permit 0)
)

(defrule
    (goal gl-land-combat-state lc-raid)
=>
    (set-goal gl-attack-permit 1)
)

(defrule
    (goal gl-land-combat-state lc-contain)
=>
    (set-goal gl-attack-permit 1)
)

(defrule
    (goal gl-land-combat-state lc-push)
=>
    (set-goal gl-attack-permit 1)
)

; ==========================================================
; MOTOR DE COMBATE NAVAL
; ==========================================================

; sin agua
(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 0)
=>
    (set-goal gl-naval-combat-state nc-ignore)
)

; defender pesca
(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (unit-type-count-total fishing-ship > 0)
    (players-unit-type-count any-enemy galley-line > 0)
=>
    (set-goal gl-naval-combat-state nc-defend-fish)
    (set-goal gl-last-major-decision md-water)
)

(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (unit-type-count-total fishing-ship > 0)
    (players-unit-type-count any-enemy fire-ship-line > 0)
=>
    (set-goal gl-naval-combat-state nc-defend-fish)
    (set-goal gl-last-major-decision md-water)
)

; contestar agua
(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (players-building-type-count any-enemy dock > 0)
    (unit-type-count-total galley-line >= 6)
=>
    (set-goal gl-naval-combat-state nc-contest-water)
    (set-goal gl-last-major-decision md-water)
)

(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (players-building-type-count any-enemy dock > 0)
    (unit-type-count-total fire-ship-line >= 6)
=>
    (set-goal gl-naval-combat-state nc-contest-water)
    (set-goal gl-last-major-decision md-water)
)

; ganar control
(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (goal gl-enemy-water-mass 0)
    (unit-type-count-total galley-line >= 10)
=>
    (set-goal gl-naval-combat-state nc-gain-control)
)

(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (goal gl-enemy-water-mass 1)
    (unit-type-count-total galley-line >= 10)
=>
    (set-goal gl-naval-combat-state nc-gain-control)
)

(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (goal gl-enemy-water-mass 2)
    (unit-type-count-total galley-line >= 10)
=>
    (set-goal gl-naval-combat-state nc-gain-control)
)

(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (goal gl-enemy-water-mass 0)
    (unit-type-count-total fire-ship-line >= 10)
=>
    (set-goal gl-naval-combat-state nc-gain-control)
)

(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (goal gl-enemy-water-mass 1)
    (unit-type-count-total fire-ship-line >= 10)
=>
    (set-goal gl-naval-combat-state nc-gain-control)
)

(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (goal gl-enemy-water-mass 2)
    (unit-type-count-total fire-ship-line >= 10)
=>
    (set-goal gl-naval-combat-state nc-gain-control)
)

; bloqueo en imperial
(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (current-age == imperial-age)
    (unit-type-count-total cannon-galleon-line >= 2)
=>
    (set-goal gl-naval-combat-state nc-blockade)
    (set-goal gl-front-creep-mode fc-water)
)

; soporte de transporte
(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (goal gl-land-combat-state lc-push)
    (unit-type-count-total transport-ship > 0)
=>
    (set-goal gl-naval-combat-state nc-transport-support)
)

; retirada naval
(defrule
    (timer-triggered t-naval-combat)
    (goal gl-water-permit 1)
    (goal gl-enemy-water-mass 3)
    (unit-type-count-total galley-line < 4)
    (unit-type-count-total fire-ship-line < 4)
=>
    (set-goal gl-naval-combat-state nc-retreat-port)
)

(defrule
    (timer-triggered t-naval-combat)
    (goal gl-naval-combat-state nc-retreat-port)
    (goal gl-enemy-water-mass 0)
=>
    (set-goal gl-naval-combat-state nc-defend-fish)
)

(defrule
    (timer-triggered t-naval-combat)
    (goal gl-naval-combat-state nc-retreat-port)
    (goal gl-enemy-water-mass 1)
=>
    (set-goal gl-naval-combat-state nc-defend-fish)
)

