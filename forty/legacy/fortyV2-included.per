)

(defrule
    (goal gl-water-permit 1)
    (goal gl-enemy-naval-comp en-fire)
=>
    (set-goal gl-doctrine-naval dn-galley-control)
)

(defrule
    (goal gl-water-permit 1)
    (goal gl-enemy-naval-comp en-demo)
=>
    (set-goal gl-doctrine-naval dn-demo-mix)
)

(defrule
    (goal gl-water-permit 1)
    (goal gl-enemy-naval-comp en-cannon)
=>
    (set-goal gl-doctrine-naval dn-cannon-control)
)

(defrule
    (goal gl-naval-combat-state nc-transport-support)
=>
    (set-goal gl-doctrine-naval dn-transport-support)
)

; ==========================================================
; AJUSTE DE DECISION MAYOR
; ==========================================================

(defrule
    (current-age <= feudal-age)
=>
    (set-goal gl-last-major-decision md-tech)
)

(defrule
    (current-age == castle-age)
=>
    (set-goal gl-last-major-decision md-eco)
)

(defrule
    (current-age == imperial-age)
    (goal gl-attack-permit 1)
=>
    (set-goal gl-last-major-decision md-attack)
)

