    (can-research ri-cannon-galleon)
=>
    (research ri-cannon-galleon)
)

; ==========================================================
; ACTIVACION DE DOCTRINAS TERRESTRES
; ==========================================================

; fallback generico
(defrule
    (current-age == dark-age)
=>
    (set-goal gl-doctrine-land dl-generic)
)

; en mapas abiertos, si hay caballeria disponible, tender a doctrina de caballeria
(defrule
    (goal gl-map-openness mo-open)
    (current-age >= castle-age)
    (can-train knight-line)
=>
    (set-goal gl-doctrine-land dl-cavalry)
)

; si el enemigo es de caballeria y tenemos camellos, pivotar
(defrule
    (goal gl-enemy-land-comp el-cavalry)
    (current-age >= castle-age)
    (can-train camel-line)
=>
    (set-goal gl-doctrine-land dl-camel)
)

; si el enemigo es de arqueria y podemos jugar CA, usar CA+situacion
(defrule
    (goal gl-enemy-land-comp el-archer)
    (current-age >= castle-age)
    (can-train cavalry-archer-line)
=>
    (set-goal gl-doctrine-land dl-ca-siege)
)

; si el enemigo es monk-siege y tenemos establos, tender a caballeria
(defrule
    (goal gl-enemy-land-comp el-monk-siege)
    (current-age >= castle-age)
    (can-train scout-cavalry-line)
=>
    (set-goal gl-doctrine-land dl-cavalry)
)

; cerrado o imperial larga = trash+siege
(defrule
    (goal gl-map-openness mo-closed)
    (current-age >= imperial-age)
=>
    (set-goal gl-doctrine-land dl-trash-siege)
)

; si ya hay castillo y UU disponible, permitir UU core
(defrule
    (current-age >= castle-age)
    (building-type-count-total castle > 0)
    (can-train my-unique-unit-line)
=>
    (set-goal gl-doctrine-land dl-uu-core)
)

; si no se cumple nada mejor, volver a generic
(defrule
    (goal gl-enemy-land-comp el-unknown)
    (current-age <= castle-age)
=>
    (set-goal gl-doctrine-land dl-generic)
)

; ==========================================================
; ACTIVACION DE DOCTRINAS NAVALES
