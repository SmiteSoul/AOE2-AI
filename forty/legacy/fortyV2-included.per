; AJUSTE DE PERMISOS SEGUN COMBATE NAVAL
; ==========================================================

(defrule
    (goal gl-naval-combat-state nc-ignore)
=>
    (set-goal gl-water-permit 0)
)

(defrule
    (goal gl-naval-combat-state nc-defend-fish)
=>
    (set-goal gl-water-permit 1)
)

(defrule
    (goal gl-naval-combat-state nc-contest-water)
=>
    (set-goal gl-water-permit 1)
)

(defrule
    (goal gl-naval-combat-state nc-gain-control)
=>
    (set-goal gl-water-permit 1)
)

(defrule
    (goal gl-naval-combat-state nc-blockade)
=>
    (set-goal gl-water-permit 1)
)

(defrule
    (goal gl-naval-combat-state nc-transport-support)
=>
    (set-goal gl-water-permit 1)
)

(defrule
    (goal gl-naval-combat-state nc-retreat-port)
=>
    (set-goal gl-water-permit 1)
)

; ==========================================================
; AJUSTE DE FRENTE PRINCIPAL
; ==========================================================

(defrule
    (goal gl-naval-combat-state nc-ignore)
    (goal gl-land-combat-state lc-hold)
=>
    (set-goal gl-primary-front fr-home)
)

(defrule
    (goal gl-land-combat-state lc-contain)
=>
    (set-goal gl-primary-front fr-mid)
)

(defrule
    (goal gl-land-combat-state lc-push)
=>
    (set-goal gl-primary-front fr-forward)
)

(defrule
    (goal gl-naval-combat-state nc-contest-water)
=>
    (set-goal gl-primary-front fr-water)
)

(defrule
    (goal gl-naval-combat-state nc-blockade)
=>
    (set-goal gl-primary-front fr-water)
)

; ==========================================================
; RESETEO DE TIMERS
; ==========================================================

(defrule
    (timer-triggered t-master)
=>
    (disable-timer t-master)
    (enable-timer t-master 14)
)

(defrule
    (timer-triggered t-land-combat)
=>
    (disable-timer t-land-combat)
    (enable-timer t-land-combat 6)
)

(defrule
    (timer-triggered t-naval-combat)
=>
    (disable-timer t-naval-combat)
    (enable-timer t-naval-combat 6)
)

; ==========================================================
; FIN BLOQUE 8/10
; EL BLOQUE 9 VA INMEDIATAMENTE DEBAJO
; ==========================================================

; ==========================================================
; semiUtils.per
; BLOQUE 9/10
; MURALLAS + DEFENSA ESTRUCTURAL + CASTILLOS
; + DUC ANTI-ASEDIO + DUC DE PUSH + DUC NAVAL
; ==========================================================

; ==========================================================
; BUILDERS DE EMERGENCIA
; ==========================================================

(defrule
    (goal gl-panic-flag 1)
=>
    (set-strategic-number sn-percent-civilian-builders 24)
    (set-strategic-number sn-cap-civilian-builders 16)
)

(defrule
    (current-age >= feudal-age)
    (wall-completed-percentage 1 < 100)
=>
    (set-strategic-number sn-percent-civilian-builders 18)
    (set-strategic-number sn-cap-civilian-builders 14)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 2 < 100)
=>
    (set-strategic-number sn-percent-civilian-builders 20)
    (set-strategic-number sn-cap-civilian-builders 16)
)

(defrule
    (goal gl-panic-flag 0)
    (wall-completed-percentage 1 >= 100)
    (wall-completed-percentage 2 >= 100)
=>
    (set-strategic-number sn-percent-civilian-builders 8)
    (set-strategic-number sn-cap-civilian-builders 10)
)

; ==========================================================
; PANIC WALL
; ==========================================================

(defrule
    (current-age == dark-age)
    (goal gl-panic-flag 1)
    (can-build-wall 1 palisade-wall)
=>
    (build-wall 1 palisade-wall)
)

(defrule
    (current-age == feudal-age)
    (goal gl-panic-flag 1)
    (can-build-wall 1 palisade-wall)
=>
    (build-wall 1 palisade-wall)
)

(defrule
    (goal gl-panic-flag 1)
    (wall-completed-percentage 1 > 15)
    (can-build-gate 1)
=>
    (build-gate 1)
)

; ==========================================================
; PERIMETRO PRINCIPAL
; ==========================================================

(defrule
    (current-age == feudal-age)
    (wall-completed-percentage 1 < 100)
    (can-build-wall 1 palisade-wall)
=>
    (build-wall 1 palisade-wall)
)

(defrule
    (current-age == feudal-age)
    (wall-completed-percentage 1 > 20)
    (can-build-gate 1)
=>
    (build-gate 1)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 1 < 100)
    (can-build-wall 1 stone-wall)
=>
    (build-wall 1 stone-wall)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 1 > 20)
    (can-build-gate 1)
=>
    (build-gate 1)
)

; ==========================================================
; BACKUP WALL / SEGUNDO PERIMETRO
; ==========================================================

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 1 > 35)
    (wall-completed-percentage 2 < 100)
    (can-build-wall 2 stone-wall)
=>
    (build-wall 2 stone-wall)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 2 > 20)
    (can-build-gate 2)
=>
    (build-gate 2)
)

; ==========================================================
; CIERRE DE BRECHAS
; ==========================================================

(defrule
    (timer-triggered t-wall-defense)
    (current-age >= castle-age)
    (town-under-attack)
    (wall-completed-percentage 1 < 90)
    (can-build-wall 1 stone-wall)
=>
    (build-wall 1 stone-wall)
)

(defrule
    (timer-triggered t-wall-defense)
    (current-age >= castle-age)
    (town-under-attack)
    (wall-completed-percentage 2 < 95)
    (can-build-wall 2 stone-wall)
=>
    (build-wall 2 stone-wall)
)

(defrule
    (timer-triggered t-wall-defense)
    (current-age == feudal-age)
    (town-under-attack)
    (wall-completed-percentage 1 < 85)
    (can-build-wall 1 palisade-wall)
=>
    (build-wall 1 palisade-wall)
)

; ==========================================================
; TORRES / OUTPOSTS
; ==========================================================

(defrule
    (current-age >= feudal-age)
    (wall-completed-percentage 1 > 10)
    (building-type-count-total watch-tower-line < 2)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)

(defrule
    (current-age == castle-age)
    (wall-completed-percentage 1 > 40)
    (building-type-count-total watch-tower-line < 4)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)

(defrule
    (current-age == imperial-age)
    (wall-completed-percentage 2 > 25)
    (building-type-count-total watch-tower-line < 6)
    (can-build watch-tower-line)
=>
    (build watch-tower-line)
)

(defrule
    (current-age >= castle-age)
    (goal gl-build-state bd-defense-core)
    (building-type-count-total outpost < 3)
    (can-build outpost)
=>
    (build outpost)
)

(defrule
    (current-age == imperial-age)
    (goal gl-build-state bd-front-creep)
    (building-type-count-total outpost < 5)
    (can-build outpost)
=>
    (build outpost)
)

; ==========================================================
; CASTILLOS
; ==========================================================

; primer castillo
(defrule
    (current-age >= castle-age)
    (stone-amount >= 650)
    (building-type-count-total castle == 0)
    (can-build castle)
=>
    (build castle)
)

; segundo castillo defensivo
(defrule
    (current-age >= castle-age)
    (town-under-attack)
    (stone-amount >= 650)
    (building-type-count-total castle < 2)
    (can-build castle)
=>
    (build castle)
)

; castillo en imperial como red defensiva
(defrule
    (current-age == imperial-age)
    (stone-amount >= 750)
    (building-type-count-total castle < 3)
    (can-build castle)
=>
    (build castle)
)

; castillos forward en control/push
(defrule
    (current-age == imperial-age)
    (goal gl-build-state bd-castle-network)
    (stone-amount >= 850)
    (building-type-count-total castle < 4)
    (player-in-game any-enemy)
    (can-build castle)
=>
    (build-forward castle)
)

(defrule
    (current-age == imperial-age)
    (goal gl-build-state bd-front-creep)
    (stone-amount >= 900)
    (building-type-count-total castle < 5)
    (player-in-game any-enemy)
    (can-build castle)
=>
    (build-forward castle)
)

; ==========================================================
; PIEDRA DEFENSIVA
; ==========================================================

(defrule
    (current-age >= castle-age)
    (building-type-count-total castle == 0)
    (stone-amount < 650)
    (gold-amount > 900)
    (can-buy-commodity stone)
=>
    (buy-commodity stone)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 1 < 100)
    (stone-amount < 250)
    (gold-amount > 900)
    (can-buy-commodity stone)
=>
    (buy-commodity stone)
)

(defrule
    (current-age >= castle-age)
    (wall-completed-percentage 2 < 100)
    (stone-amount < 300)
    (gold-amount > 1100)
    (can-buy-commodity stone)
=>
    (buy-commodity stone)
)

; ==========================================================
; DUC ANTI-ASEDIO
; Salida corta con caballeria rapida / camellos / knight
; ==========================================================

(defrule
    (timer-triggered t-duc-sortie)
    (current-age >= castle-age)
    (town-under-attack)
=>
    (up-find-player enemy find-closest gl-primary-enemy)
    (up-modify-sn sn-focus-player-number g:= gl-primary-enemy)
    (up-full-reset-search)
    (up-find-local c: scout-cavalry-line c: 6)
    (up-find-local c: knight-line c: 4)
    (up-find-local c: camel-line c: 4)
    (up-find-remote c: battering-ram-line c: 1)
    (up-find-remote c: mangonel-line c: 1)
    (up-find-remote c: scorpion-line c: 1)
    (up-find-remote c: trebuchet c: 1)
    (up-find-remote c: bombard-cannon c: 1)
    (up-get-search-state gl-search-main)
)

(defrule
    (timer-triggered t-duc-sortie)
    (current-age >= castle-age)
    (town-under-attack)
    (up-compare-goal gl-search-main c:> 0)
=>
    (set-goal gl-duc-state duc-anti-siege)
    (up-target-objects 0 action-default -1 -1)
)

(defrule
    (timer-triggered t-duc-sortie)
    (goal gl-duc-state duc-anti-siege)
    (not (town-under-attack))
=>
    (up-full-reset-search)
    (up-find-local c: scout-cavalry-line c: 10)
    (up-find-local c: knight-line c: 8)
    (up-find-local c: camel-line c: 8)
    (up-get-search-state gl-search-main)
)

(defrule
    (timer-triggered t-duc-sortie)
    (goal gl-duc-state duc-anti-siege)
    (not (town-under-attack))
    (up-compare-goal gl-search-main c:> 0)
=>
    (up-target-point gl-home-x action-move -1 -1)
    (set-goal gl-duc-state duc-idle)
)

; ==========================================================
; DUC DE PUSH TERRESTRE
; 1) trebs/BBC enfocan objetivos estructurales
; ==========================================================

(defrule
    (timer-triggered t-duc-anchor)
    (goal gl-land-combat-state lc-push)
    (current-age == imperial-age)
=>
    (up-find-player enemy find-closest gl-primary-enemy)
    (up-modify-sn sn-focus-player-number g:= gl-primary-enemy)
    (up-full-reset-search)
    (up-find-local c: trebuchet c: 8)
    (up-find-local c: bombard-cannon c: 4)
    (up-find-remote c: castle c: 1)
    (up-find-remote c: town-center c: 1)
    (up-find-remote c: siege-workshop c: 1)
    (up-find-remote c: archery-range c: 1)
    (up-find-remote c: stable c: 1)
    (up-find-remote c: barracks c: 1)
    (up-get-search-state gl-search-main)
)

(defrule
    (timer-triggered t-duc-anchor)
    (goal gl-land-combat-state lc-push)
    (current-age == imperial-age)
    (up-compare-goal gl-search-main c:> 0)
=>
    (set-goal gl-duc-state duc-land-focus-fire)
    (up-target-objects 0 action-default -1 -1)
)

; 2) si entramos en regroup/retreat, devolver unidades de alto valor
(defrule
    (timer-triggered t-duc-anchor)
    (goal gl-land-combat-state lc-regroup)
=>
    (up-full-reset-search)
    (up-find-local c: trebuchet c: 8)
    (up-find-local c: bombard-cannon c: 4)
    (up-find-local c: mangonel-line c: 6)
    (up-get-search-state gl-search-main)
)

(defrule
    (timer-triggered t-duc-anchor)
    (goal gl-land-combat-state lc-regroup)
    (up-compare-goal gl-search-main c:> 0)
=>
    (set-goal gl-duc-state duc-fallback)
    (up-target-point gl-fallback-x action-move -1 -1)
)

(defrule
    (timer-triggered t-duc-anchor)
    (goal gl-land-combat-state lc-retreat)
=>
    (up-full-reset-search)
    (up-find-local c: trebuchet c: 8)
    (up-find-local c: bombard-cannon c: 4)
    (up-find-local c: mangonel-line c: 6)
    (up-get-search-state gl-search-main)
)

(defrule
    (timer-triggered t-duc-anchor)
    (goal gl-land-combat-state lc-retreat)
    (up-compare-goal gl-search-main c:> 0)
=>
    (set-goal gl-duc-state duc-fallback)
    (up-target-point gl-home-x action-move -1 -1)
)

; ==========================================================
; DUC NAVAL PUNTUAL
; ==========================================================

; foco contra cannon galleons o docks
(defrule
    (timer-triggered t-duc-naval)
    (goal gl-water-permit 1)
    (goal gl-naval-combat-state nc-blockade)
=>
    (up-find-player enemy find-closest gl-primary-enemy)
    (up-modify-sn sn-focus-player-number g:= gl-primary-enemy)
    (up-full-reset-search)
    (up-find-local c: cannon-galleon-line c: 4)
    (up-find-local c: galley-line c: 12)
    (up-find-remote c: cannon-galleon-line c: 1)
    (up-find-remote c: dock c: 1)
    (up-get-search-state gl-search-main)
)

(defrule
    (timer-triggered t-duc-naval)
    (goal gl-water-permit 1)
    (goal gl-naval-combat-state nc-blockade)
    (up-compare-goal gl-search-main c:> 0)
=>
    (set-goal gl-duc-state duc-cannon-focus)
    (up-target-objects 0 action-default -1 -1)
)

; strike puntual con demos
(defrule
    (timer-triggered t-duc-naval)
    (goal gl-water-permit 1)
    (goal gl-doctrine-naval dn-demo-mix)
=>
    (up-find-player enemy find-closest gl-primary-enemy)
    (up-modify-sn sn-focus-player-number g:= gl-primary-enemy)
    (up-full-reset-search)
    (up-find-local c: demolition-ship-line c: 4)
    (up-find-remote c: galley-line c: 1)
    (up-find-remote c: fire-ship-line c: 1)
    (up-get-search-state gl-search-main)
)

(defrule
    (timer-triggered t-duc-naval)
    (goal gl-water-permit 1)
    (goal gl-doctrine-naval dn-demo-mix)
    (up-compare-goal gl-search-main c:> 0)
=>
    (set-goal gl-duc-state duc-naval-demo-strike)
    (up-target-objects 0 action-default -1 -1)
)

; ==========================================================
; AJUSTE DE FALLBACK / CASA
; ==========================================================

(defrule
    (current-age >= castle-age)
    (building-type-count-total town-center > 0)
=>
    (up-get-point position-self gl-home-x)
)

(defrule
    (goal gl-land-combat-state lc-push)
    (current-age == imperial-age)
=>
    (up-get-point position-self gl-fallback-x)
)

; ==========================================================
; TIMER RESET
; ==========================================================

(defrule
    (timer-triggered t-wall-defense)
=>
    (disable-timer t-wall-defense)
    (enable-timer t-wall-defense 3)
)

(defrule
    (timer-triggered t-duc-sortie)
=>
    (disable-timer t-duc-sortie)
    (enable-timer t-duc-sortie 3)
)

(defrule
    (timer-triggered t-duc-anchor)
=>
    (disable-timer t-duc-anchor)
    (enable-timer t-duc-anchor 4)
)

(defrule
    (timer-triggered t-duc-naval)
=>
    (disable-timer t-duc-naval)
    (enable-timer t-duc-naval 4)
)

; ==========================================================
; FIN BLOQUE 9/10
; EL BLOQUE 10 VA INMEDIATAMENTE DEBAJO
; ==========================================================

; ==========================================================
; semiUtils.per
; BLOQUE 10/10
; CORRECCION ECONOMICA + MERCADO/TRADE + WATCHDOG
; + LIMPIEZA DE FLAGS + RESET FINAL DE TIMERS
; ==========================================================

; ==========================================================
; ECO FAST - DETECCION DE CUELLOS DE BOTELLA
; ==========================================================

(defrule
    (timer-triggered t-eco-fast)
    (food-amount < 250)
=>
    (set-goal gl-eco-state ec-need-food)
)

(defrule
    (timer-triggered t-eco-fast)
    (wood-amount < 180)
=>
    (set-goal gl-eco-state ec-need-wood)
)

(defrule
    (timer-triggered t-eco-fast)
    (current-age >= feudal-age)
    (gold-amount < 120)
=>
    (set-goal gl-eco-state ec-need-gold)
)

(defrule
    (timer-triggered t-eco-fast)
    (current-age >= castle-age)
    (stone-amount < 120)
    (building-type-count-total castle == 0)
=>
    (set-goal gl-eco-state ec-need-stone)
)

(defrule
    (timer-triggered t-eco-fast)
    (current-age >= castle-age)
    (food-amount < 350)
    (wood-amount > 250)
=>
    (set-goal gl-eco-state ec-reseed-farms)
)

(defrule
    (timer-triggered t-eco-fast)
    (goal gl-water-permit 1)
    (unit-type-count-total fishing-ship < 4)
    (current-age <= castle-age)
=>
    (set-goal gl-eco-state ec-need-fish)
)

; ==========================================================
; ECO FAST - REBALANCEO CORRECTIVO
; ==========================================================

(defrule
    (timer-triggered t-eco-fast)
    (goal gl-eco-state ec-need-food)
=>
    (set-strategic-number sn-food-gatherer-percentage 48)
    (set-strategic-number sn-wood-gatherer-percentage 26)
    (set-strategic-number sn-gold-gatherer-percentage 18)
    (set-strategic-number sn-stone-gatherer-percentage 8)
)

(defrule
    (timer-triggered t-eco-fast)
    (goal gl-eco-state ec-need-wood)
=>
    (set-strategic-number sn-food-gatherer-percentage 38)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 16)
    (set-strategic-number sn-stone-gatherer-percentage 6)
)

(defrule
    (timer-triggered t-eco-fast)
    (goal gl-eco-state ec-need-gold)
=>
    (set-strategic-number sn-food-gatherer-percentage 36)
    (set-strategic-number sn-wood-gatherer-percentage 24)
    (set-strategic-number sn-gold-gatherer-percentage 32)
    (set-strategic-number sn-stone-gatherer-percentage 8)
)

(defrule
    (timer-triggered t-eco-fast)
    (goal gl-eco-state ec-need-stone)
=>
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 24)
    (set-strategic-number sn-gold-gatherer-percentage 22)
    (set-strategic-number sn-stone-gatherer-percentage 20)
)

(defrule
    (timer-triggered t-eco-fast)
    (goal gl-eco-state ec-need-fish)
=>
    (set-strategic-number sn-food-gatherer-percentage 30)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 20)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

(defrule
    (timer-triggered t-eco-fast)
    (goal gl-eco-state ec-reseed-farms)
=>
    (set-strategic-number sn-food-gatherer-percentage 44)
    (set-strategic-number sn-wood-gatherer-percentage 30)
    (set-strategic-number sn-gold-gatherer-percentage 18)
    (set-strategic-number sn-stone-gatherer-percentage 8)
)

; ==========================================================
; ECO SLOW - NORMALIZACION Y EXPANSION
; ==========================================================

(defrule
    (timer-triggered t-eco-slow)
    (food-amount >= 450)
    (wood-amount >= 350)
    (current-age == feudal-age)
=>
    (set-goal gl-eco-state ec-balanced)
)

(defrule
    (timer-triggered t-eco-slow)
    (food-amount >= 550)
    (wood-amount >= 450)
    (gold-amount >= 220)
    (current-age == castle-age)
=>
    (set-goal gl-eco-state ec-balanced)
)

(defrule
    (timer-triggered t-eco-slow)
    (food-amount >= 650)
    (wood-amount >= 500)
    (gold-amount >= 350)
    (current-age == imperial-age)
=>
    (set-goal gl-eco-state ec-balanced)
)

(defrule
    (timer-triggered t-eco-slow)
    (civilian-population >= 40)
    (building-type-count-total lumber-camp < 3)
=>
    (set-goal gl-eco-state ec-expand-dropsites)
)

(defrule
    (timer-triggered t-eco-slow)
    (civilian-population >= 50)
    (building-type-count-total mill < 3)
=>
    (set-goal gl-eco-state ec-expand-dropsites)
)

(defrule
    (timer-triggered t-eco-slow)
    (civilian-population >= 55)
    (building-type-count-total mining-camp < 2)
=>
    (set-goal gl-eco-state ec-expand-dropsites)
)

; ==========================================================
; ECO SLOW - ESTADO BALANCEADO POR TEATRO
; ==========================================================

(defrule
    (timer-triggered t-eco-slow)
    (goal gl-eco-state ec-balanced)
    (goal gl-theater th-land-open)
    (current-age == castle-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 40)
    (set-strategic-number sn-wood-gatherer-percentage 28)
    (set-strategic-number sn-gold-gatherer-percentage 22)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

(defrule
    (timer-triggered t-eco-slow)
    (goal gl-eco-state ec-balanced)
    (goal gl-theater th-land-open)
    (current-age == imperial-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 33)
    (set-strategic-number sn-wood-gatherer-percentage 24)
    (set-strategic-number sn-gold-gatherer-percentage 28)
    (set-strategic-number sn-stone-gatherer-percentage 15)
)

(defrule
    (timer-triggered t-eco-slow)
    (goal gl-eco-state ec-balanced)
    (goal gl-map-openness mo-closed)
    (current-age >= castle-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 38)
    (set-strategic-number sn-wood-gatherer-percentage 24)
    (set-strategic-number sn-gold-gatherer-percentage 20)
    (set-strategic-number sn-stone-gatherer-percentage 18)
)

(defrule
    (timer-triggered t-eco-slow)
    (goal gl-eco-state ec-balanced)
    (goal gl-theater th-hybrid)
    (current-age >= castle-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 34)
    (set-strategic-number sn-wood-gatherer-percentage 34)
    (set-strategic-number sn-gold-gatherer-percentage 22)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

(defrule
    (timer-triggered t-eco-slow)
    (goal gl-eco-state ec-balanced)
    (goal gl-theater th-water)
    (current-age >= castle-age)
=>
    (set-strategic-number sn-food-gatherer-percentage 30)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 25)
    (set-strategic-number sn-stone-gatherer-percentage 10)
)

; ==========================================================
; BUILD / RECOVERY AUXILIAR
; ==========================================================

(defrule
    (timer-triggered t-build)
    (current-age >= castle-age)
    (soldier-count < 8)
=>
    (set-goal gl-build-state bd-rebuild)
)

(defrule
    (timer-triggered t-build)
    (goal gl-strat-state st-imp-push)
=>
    (set-goal gl-build-state bd-front-creep)
)

(defrule
    (timer-triggered t-build)
    (goal gl-strat-state st-imp-control)
=>
    (set-goal gl-build-state bd-castle-network)
)

(defrule
    (timer-triggered t-build)
    (goal gl-theater th-water)
    (goal gl-water-permit 1)
=>
    (set-goal gl-build-state bd-naval-production)
)

; ==========================================================
; MARKET / TRADE TIMER
; ==========================================================

(defrule
    (timer-triggered t-market-trade)
    (players-building-type-count any-ally market > 0)
    (current-age >= castle-age)
=>
    (set-goal gl-trade-permit 1)
)

(defrule
    (timer-triggered t-market-trade)
    (goal gl-trade-permit 1)
    (gold-amount > 1800)
    (food-amount < 600)
    (can-buy-commodity food)
=>
    (buy-commodity food)
)

(defrule
    (timer-triggered t-market-trade)
    (goal gl-trade-permit 1)
    (gold-amount > 1600)
    (wood-amount < 400)
    (can-buy-commodity wood)
=>
    (buy-commodity wood)
)

(defrule
    (timer-triggered t-market-trade)
    (building-type-count-total castle < 2)
    (current-age >= castle-age)
    (gold-amount > 1500)
    (stone-amount < 650)
    (can-buy-commodity stone)
=>
    (buy-commodity stone)
)

; ==========================================================
; LIMPIEZA DE FLAGS ENEMIGOS
; ==========================================================

(defrule
    (players-building-type-count any-enemy siege-workshop == 0)
    (players-unit-type-count any-enemy battering-ram-line == 0)
    (players-unit-type-count any-enemy mangonel-line == 0)
    (players-unit-type-count any-enemy scorpion-line == 0)
    (players-unit-type-count any-enemy bombard-cannon == 0)
    (players-unit-type-count any-enemy trebuchet == 0)
=>
    (set-goal gl-enemy-siege-flag 0)
)

(defrule
    (players-unit-type-count any-enemy monk == 0)
=>
    (set-goal gl-enemy-monk-flag 0)
)

(defrule
    (players-building-type-count any-enemy castle == 0)
=>
    (set-goal gl-enemy-castle-flag 0)
)

(defrule
    (players-building-type-count any-enemy dock == 0)
    (players-unit-type-count any-enemy fishing-ship == 0)
    (players-unit-type-count any-enemy galley-line == 0)
    (players-unit-type-count any-enemy fire-ship-line == 0)
    (players-unit-type-count any-enemy demolition-ship-line == 0)
    (players-unit-type-count any-enemy cannon-galleon-line == 0)
=>
    (set-goal gl-enemy-dock-flag 0)
    (set-goal gl-enemy-water-mass 0)
    (set-goal gl-enemy-naval-comp en-unknown)
)

(defrule
    (not (town-under-attack))
=>
    (set-goal gl-enemy-raiding-flag 0)
)

; ==========================================================
; WATCHDOG - CORRECCION DE ESTADOS INVALIDOS
; ==========================================================

; sin enemigos: no atacar
(defrule
    (timer-triggered t-watchdog)
    (not (player-in-game any-enemy))
=>
    (set-goal gl-attack-permit 0)
    (set-goal gl-land-combat-state lc-hold)
    (set-goal gl-naval-combat-state nc-ignore)
    (set-goal gl-last-major-decision md-none)
)

; sin agua: apagar naval
(defrule
    (timer-triggered t-watchdog)
    (goal gl-water-permit 0)
=>
    (set-goal gl-doctrine-naval dn-none)
    (set-goal gl-naval-combat-state nc-ignore)
    (set-goal gl-target-class-water tg-water-none)
)

; sin masa terrestre: no empujar
(defrule
    (timer-triggered t-watchdog)
    (soldier-count < 8)
=>
    (set-goal gl-attack-permit 0)
    (set-goal gl-land-combat-state lc-hold)
    (set-goal gl-anchor-ready-land 0)
)

; push sin ancla real -> volver a control
(defrule
    (timer-triggered t-watchdog)
    (goal gl-land-combat-state lc-push)
    (current-age == imperial-age)
    (unit-type-count-total trebuchet == 0)
    (unit-type-count-total bombard-cannon == 0)
    (unit-type-count-total battering-ram-line == 0)
    (unit-type-count-total mangonel-line == 0)
=>
    (set-goal gl-land-combat-state lc-contain)
    (set-goal gl-anchor-ready-land 0)
)

; si el agua se pierde totalmente, volver a defensa de fish / ignore
(defrule
    (timer-triggered t-watchdog)
    (goal gl-water-permit 1)
    (unit-type-count-total dock == 0)
    (unit-type-count-total fishing-ship == 0)
    (unit-type-count-total galley-line == 0)
    (unit-type-count-total fire-ship-line == 0)
    (unit-type-count-total demolition-ship-line == 0)
    (unit-type-count-total cannon-galleon-line == 0)
=>
    (set-goal gl-naval-combat-state nc-ignore)
)

; doctrine fallback si algo raro queda sin definir
(defrule
    (timer-triggered t-watchdog)
    (current-age == dark-age)
=>
    (set-goal gl-doctrine-land dl-generic)
)

(defrule
    (timer-triggered t-watchdog)
    (goal gl-water-permit 0)
=>
    (set-goal gl-doctrine-naval dn-none)
)

(defrule
    (timer-triggered t-watchdog)
    (goal gl-water-permit 1)
    (goal gl-enemy-naval-comp en-unknown)
=>
    (set-goal gl-doctrine-naval dn-galley-control)
)

; target fallback
(defrule
    (timer-triggered t-watchdog)
    (goal gl-target-class-land tg-land-none)
    (current-age >= castle-age)
=>
    (set-goal gl-target-class-land tg-land-production)
)

(defrule
    (timer-triggered t-watchdog)
    (goal gl-target-class-water tg-water-none)
    (goal gl-water-permit 1)
    (players-building-type-count any-enemy dock > 0)
=>
    (set-goal gl-target-class-water tg-water-dock)
)

(defrule
    (timer-triggered t-watchdog)
    (goal gl-target-class-water tg-water-none)
    (goal gl-water-permit 1)
    (players-building-type-count any-enemy dock == 0)
=>
    (set-goal gl-target-class-water tg-water-fleet)
)

; mantener frente coherente
(defrule
    (timer-triggered t-watchdog)
    (goal gl-land-combat-state lc-hold)
    (goal gl-naval-combat-state nc-ignore)
=>
    (set-goal gl-primary-front fr-home)
)

; ==========================================================
; WATCHDOG - PUNTOS BASE DUC
; ==========================================================

(defrule
    (timer-triggered t-watchdog)
    (building-type-count-total town-center > 0)
=>
    (up-get-point position-self gl-home-x)
)

(defrule
    (timer-triggered t-watchdog)
    (goal gl-land-combat-state lc-push)
=>
    (up-get-point position-self gl-fallback-x)
)

; ==========================================================
; LIMPIEZA DE SCRATCH / SCORE BANK
; ==========================================================

(defrule
    (timer-triggered t-watchdog)
=>
    (set-goal gl-score-a 0)
    (set-goal gl-score-b 0)
    (set-goal gl-score-c 0)
    (set-goal gl-score-d 0)
    (set-goal gl-best-score 0)
    (set-goal gl-alt-score 0)
)

; ==========================================================
; RESET DE TIMERS RESTANTES
; ==========================================================

(defrule
    (timer-triggered t-eco-fast)
=>
    (disable-timer t-eco-fast)
    (enable-timer t-eco-fast 5)
)

(defrule
    (timer-triggered t-eco-slow)
=>
    (disable-timer t-eco-slow)
    (enable-timer t-eco-slow 11)
)

(defrule
    (timer-triggered t-build)
=>
    (disable-timer t-build)
    (enable-timer t-build 7)
)

(defrule
    (timer-triggered t-train-land)
=>
    (disable-timer t-train-land)
    (enable-timer t-train-land 4)
)

(defrule
    (timer-triggered t-train-naval)
=>
    (disable-timer t-train-naval)
    (enable-timer t-train-naval 4)
)

(defrule
    (timer-triggered t-tech)
=>
    (disable-timer t-tech)
    (enable-timer t-tech 9)
)

(defrule
    (timer-triggered t-market-trade)
=>
    (disable-timer t-market-trade)
    (enable-timer t-market-trade 10)
)

(defrule
    (timer-triggered t-watchdog)
=>
    (disable-timer t-watchdog)
    (enable-timer t-watchdog 15)
)

