; =====================================================================
; FORTY - EL REINO FORTIFICADO (version unificada)
;
; IA de ciudades fortificadas para AoC + UserPatch 1.5. Un solo .per
; autocontenido (constantes UP incluidas). Combina:
;   - forty v1 (identidad: reino fortificado, defensa, gestion propia)
;   - fortyV2 (doctrinas de construccion y maquinas de estado)
;   - semiUtils (director de modos: gl-mode + t-director)
;
; DOCTRINA URBANA MEDIEVAL (investigacion historica documentada en
; docs/06_Forty_Feudo.md):
;   - El "castillo fuerte" del feudo            -> (build castle)
;   - El patio de servicios (bailey)            -> edificios densos
;   - Los frentes de burgage (casas-calle)      -> anillo de casas = muro
;   - La plaza de mercado                       -> (build market)
;   - La iglesia parroquial                     -> (build monastery)
;   - La muralla exterior (empalizada -> piedra)   -> build-wall perimetro 1
;   - La muralla interior (doble anillo de piedra) -> build-wall perimetro 2
;   - Las puertas de los tramos                    -> build-gate
;   - Las torres de la muralla                     -> (build watch-tower)
;   - El bailiff (gestion diaria del feudo)        -> director + fases
;
; SISTEMA DE MURALLAS: el motor SIE PERMITE construir murallas a los AIs
; con el juego de comandos
; enable-wall-placement / can-build-wall / build-wall / can-build-gate /
; build-gate / wall-completed-percentage [CORPUS: build-wall 11x,
; build-gate 6x, wall-completed-percentage 60x]. Se planifican DOS
; perimetros: el EXTERIOR primero en empalizada (Feudal) y luego en
; piedra (Castillo), y el INTERIOR en piedra (Castillo). Es el mismo
; sistema que usaban forty v1 y v2 (forty/legacy/). El anillo de casas
; (burgage), las torres y el castillo completan la fortaleza por dentro.
; =====================================================================

; =====================================================================
; CONSTANTES PROPIAS
; =====================================================================

; ---------- Estado ----------
(defconst gl-mode 10)             ; director de modos (herencia semiUtils/v1)
(defconst gl-city 11)             ; fase de la ciudad
(defconst gl-wave 12)             ; 0 = sin oleada, 1 = oleada de asalto
(defconst gl-first-chat 13)       ; chat de presentacion
(defconst gl-temp 14)             ; temporal DUC
(defconst gl-pt1 20)              ; punto DUC (x,y) = goals 20-21
(defconst gl-pt1-y 21)
(defconst gl-local-total 30)      ; estado de busqueda DUC
(defconst gl-local-last 31)
(defconst gl-remote-total 32)
(defconst gl-remote-last 33)

; ---------- Valores del director ----------
(defconst m-grow 0)               ; gestionar y crecer el feudo
(defconst m-defend 1)             ; la ciudad es atacada: muralla viva
(defconst m-attack 2)             ; campana militar organizada

; ---------- Fases de la ciudad ----------
(defconst cty-aldea 1)            ; aldea: sobrevivir (casas, granja, lena, oro)
(defconst cty-villa 2)            ; villa: plaza, gremios (market, blacksmith, cuarteles)
(defconst cty-muralla 3)          ; villa amurallada: torres, anillo de casas, piedra
(defconst cty-plaza 4)            ; plaza fuerte: castillo, asedio, ejercito

; ---------- Timers ----------
(defconst t-director 1)           ; pulso del director (modos y fases)
(defconst t-micro 2)              ; micro DUC (fuego concentrado, asedio)
(defconst t-push 3)               ; avance de TSA durante el asalto
(defconst t-eco 4)                ; reajuste economico y mercado

; ---------- Constantes de proyecto ----------
(defconst villa-houses 22)        ; casas minimas para considerar la villa completa
(defconst plaza-towers 2)         ; torres minimas para la plaza fuerte

; =====================================================================
; INIT: VELOCIDAD Y RESPUESTA (patrones verificados de Barbarian/foros)
; =====================================================================
(defrule
	(true)
=>
	(set-strategic-number sn-initial-exploration-required 0)
	(set-strategic-number sn-defer-dropsite-update 1)
	(set-strategic-number sn-cap-civilian-builders 30)
	(set-strategic-number sn-task-ungrouped-soldiers 1)
	(set-strategic-number sn-consecutive-idle-unit-limit 1)
	(disable-self)
)
(defrule
	(true)
=>
	(set-strategic-number sn-percent-enemy-sighted-response 100)
	(set-strategic-number sn-enemy-sighted-response-distance 100)
	(set-strategic-number sn-gather-defense-units 1)
	(set-strategic-number sn-allow-civilian-defense 1)
	(set-strategic-number sn-zero-priority-distance 50)
	(disable-self)
)
; Grupos: oleadas escalonadas (2-12), formacion rapida, defensa propia
(defrule
	(true)
=>
	(set-strategic-number sn-number-attack-groups 0)
	(set-strategic-number sn-minimum-attack-group-size 2)
	(set-strategic-number sn-maximum-attack-group-size 12)
	(set-strategic-number sn-scale-minimum-attack-group-size 0)
	(set-strategic-number sn-scale-maximum-attack-group-size 0)
	(set-strategic-number sn-group-form-distance 30)
	(disable-self)
)
(defrule
	(true)
=>
	(set-strategic-number sn-number-defend-groups 3)
	(set-strategic-number sn-minimum-defend-group-size 2)
	(set-strategic-number sn-maximum-defend-group-size 8)
	(set-strategic-number sn-minimum-town-size 10)
	(set-strategic-number sn-maximum-town-size 28)
	(set-strategic-number sn-camp-max-distance 10)
	(set-strategic-number sn-wall-targeting-mode 1)
	(disable-self)
)

; =====================================================================
; =====================================================================
; PLANIFICACION DE MURALLAS: doble perimetro habilitado (v1/v2)
; =====================================================================
(defrule
	(true)
=>
	(enable-wall-placement 1)
	(enable-wall-placement 2)
	(set-strategic-number sn-percent-civilian-builders 10)
	(set-strategic-number sn-cap-civilian-builders 10)
	(disable-self)
)

; =====================================================================
; PRESENTACION
; =====================================================================
(defrule
	(game-time > 2)
	(goal gl-first-chat 0)
=>
	(set-goal gl-first-chat 1)
	(chat-to-all "FORTY: el feudo despierta.")
)

; =====================================================================
; DIRECTOR: modos y fases de la ciudad (el bailiff del feudo)
; =====================================================================
; Modos: defensa si atacan; asalto si hay ejercito; si no, crecer.
(defrule
	(timer-triggered t-director)
	(goal gl-mode m-grow)
	(town-under-attack)
=>
	(set-goal gl-mode m-defend)
)
(defrule
	(timer-triggered t-director)
	(goal gl-mode m-defend)
	(not (town-under-attack))
	(military-population < 8)
=>
	(set-goal gl-mode m-grow)
)
(defrule
	(timer-triggered t-director)
	(goal gl-mode m-grow)
	(not (town-under-attack))
	(or	(military-population >= 35)
		(unit-type-count-total trebuchet > 0))
=>
	(set-goal gl-mode m-attack)
)
(defrule
	(timer-triggered t-director)
	(goal gl-mode m-attack)
	(or	(town-under-attack)
		(military-population < 15))
=>
	(set-goal gl-mode m-defend)
)
; Fases de la ciudad: aldea -> villa -> muralla -> plaza fuerte
(defrule
	(timer-triggered t-director)
	(goal gl-city cty-aldea)
	(current-age >= feudal-age)
=>
	(set-goal gl-city cty-villa)
	(chat-to-all "FORTY: la aldea se convierte en villa.")
)
(defrule
	(timer-triggered t-director)
	(goal gl-city cty-villa)
	(current-age >= castle-age)
	(building-type-count-total house >= villa-houses)
=>
	(set-goal gl-city cty-muralla)
	(chat-to-all "FORTY: la villa se amuralla.")
)
(defrule
	(timer-triggered t-director)
	(goal gl-city cty-muralla)
	(building-type-count castle > 0)
	(building-type-count-total watch-tower >= plaza-towers)
=>
	(set-goal gl-city cty-plaza)
	(chat-to-all "FORTY: la plaza fuerte esta en pie.")
)

; =====================================================================
; ECONOMIA (gestion del feudo)
; =====================================================================
(defrule
	(can-train villager)
	(unit-type-count-total villager < 110)
=>
	(train villager)
)
(defrule
	(housing-headroom < 4)
	(population-headroom > 0)
	(can-build house)
=>
	(build house)
)
(defrule
	(building-type-count-total mill == 0)
	(can-build mill)
=>
	(build mill)
)
(defrule
	(or	(dropsite-min-distance wood > 3)
		(building-type-count-total lumber-camp == 0))
	(resource-found wood)
	(can-build lumber-camp)
	(building-type-count-total lumber-camp < 3)
=>
	(build lumber-camp)
)
(defrule
	(or	(dropsite-min-distance gold > 4)
		(building-type-count-total mining-camp == 0))
	(resource-found gold)
	(can-build mining-camp)
	(building-type-count-total mining-camp < 3)
=>
	(build mining-camp)
)
(defrule
	(idle-farm-count < 2)
	(wood-amount > 120)
	(can-build farm)
	(building-type-count-total mill > 0)
=>
	(build farm)
)
; Centro urbano destruido: reconstruir el corazon del feudo
(defrule
	(building-type-count town-center == 0)
	(can-build town-center)
=>
	(build town-center)
	(up-assign-builders c: town-center-foundation c: 4)
)

; =====================================================================
; CONSTRUCCION DE LA CIUDAD POR FASES (doctrina burgage/bailey)
; =====================================================================
; --- Fase aldea: ya cubierta por economia (casas, granja, campamentos)

; --- Fase villa: plaza de mercado, gremios y cuarteles
(defrule
	(goal gl-city cty-villa)
	(building-type-count-total market == 0)
	(can-build market)
=>
	(build market)
)
(defrule
	(goal gl-city cty-villa)
	(building-type-count-total blacksmith == 0)
	(can-build blacksmith)
=>
	(build blacksmith)
)
(defrule
	(goal gl-city cty-villa)
	(building-type-count-total barracks < 2)
	(can-build barracks)
=>
	(build barracks)
)
(defrule
	(goal gl-city cty-villa)
	(building-type-count-total archery-range < 2)
	(can-build archery-range)
=>
	(build archery-range)
)
(defrule
	(goal gl-city cty-villa)
	(current-age >= castle-age)
	(building-type-count-total monastery == 0)
	(can-build monastery)
=>
	(build monastery)
)

; --- Fase muralla: piedra y torres (la muralla de verdad la levanta
;     la seccion MURALLAS con build-wall: perimetro 1 piedra + perimetro 2)
(defrule
	(goal gl-city cty-muralla)
	(can-build watch-tower)
	(building-type-count-total watch-tower < 6)
=>
	(build watch-tower)
	(up-assign-builders c: watch-tower c: 3)
)
(defrule
	(goal gl-city cty-muralla)
	(can-build house)
	(building-type-count-total house < 30)
=>
	(build house)
)

; --- Fase plaza fuerte: el castillo (motte/keep) y el distrito militar
(defrule
	(goal gl-city cty-plaza)
	(can-build castle)
	(building-type-count-total castle < 2)
=>
	(build castle)
	(up-assign-builders c: castle c: 4)
)
; --- doctrina eco-expand: segundo centro urbano (patron corpus: can-build 40x)
(defrule
	(goal gl-city cty-plaza)
	(current-age >= castle-age)
	(building-type-count-total town-center < 2)
	(can-build town-center)
=>
	(build town-center)
	(up-assign-builders c: town-center-foundation c: 4)
)
(defrule
	(goal gl-city cty-plaza)
	(can-build siege-workshop)
	(building-type-count-total siege-workshop < 2)
=>
	(build siege-workshop)
)
; --- distrito militar ampliado (cuarteles/gremios de la plaza)
(defrule
	(goal gl-city cty-plaza)
	(can-build barracks)
	(building-type-count-total barracks < 3)
=>
	(build barracks)
)
(defrule
	(goal gl-city cty-plaza)
	(can-build archery-range)
	(building-type-count-total archery-range < 3)
=>
	(build archery-range)
)
(defrule
	(goal gl-city cty-plaza)
	(can-build stable)
	(building-type-count-total stable < 2)
=>
	(build stable)
)
(defrule
	(goal gl-city cty-plaza)
	(can-build monastery)
	(building-type-count-total monastery < 2)
=>
	(build monastery)
)
(defrule
	(goal gl-city cty-plaza)
	(can-build university)
	(building-type-count-total university < 1)
=>
	(build university)
)
; --- torres de bombardas en Imperial (corpus: can-build 18x)
(defrule
	(goal gl-city cty-plaza)
	(current-age >= imperial-age)
	(can-build bombard-tower)
	(building-type-count-total bombard-tower < 4)
=>
	(build bombard-tower)
)
; Ampliacion: mas torres y casas crecen con la plaza
(defrule
	(goal gl-city cty-plaza)
	(can-build watch-tower)
	(building-type-count-total watch-tower < 10)
=>
	(build watch-tower)
	(up-assign-builders c: watch-tower c: 3)
)
(defrule
	(goal gl-city cty-plaza)
	(can-build house)
	(building-type-count-total house < 42)
=>
	(build house)
)

; =====================================================================
; MURALLAS: DOBLE PERIMETRO (herencia forty v1/v2)
; Exterior (perimetro 1): empalizada en Feudal -> piedra desde Castillo.
; Interior (perimetro 2): piedra desde Castillo, cuando el exterior
; lleva media hecha. Puertas en cuanto el tramo avanza. Los constructores
; se refuerzan mientras quede muralla por hacer (patron v1).
; =====================================================================
(defrule
	(current-age >= feudal-age)
	(wall-completed-percentage 1 < 100)
=>
	(set-strategic-number sn-percent-civilian-builders 20)
	(set-strategic-number sn-cap-civilian-builders 18)
)
(defrule
	(current-age >= castle-age)
	(wall-completed-percentage 2 < 100)
=>
	(set-strategic-number sn-percent-civilian-builders 22)
	(set-strategic-number sn-cap-civilian-builders 20)
)
(defrule
	(current-age >= castle-age)
	(wall-completed-percentage 1 >= 100)
	(wall-completed-percentage 2 >= 100)
=>
	(set-strategic-number sn-percent-civilian-builders 10)
	(set-strategic-number sn-cap-civilian-builders 10)
)
; --- perimetro exterior: empalizada feudal
(defrule
	(current-age == feudal-age)
	(wall-completed-percentage 1 < 100)
	(can-build-wall 1 palisade-wall)
=>
	(build-wall 1 palisade-wall)
)
(defrule
	(current-age == feudal-age)
	(wall-completed-percentage 1 > 15)
	(can-build-gate 1)
=>
	(build-gate 1)
)
; --- perimetro exterior: piedra desde castillo
(defrule
	(current-age >= castle-age)
	(wall-completed-percentage 1 < 100)
	(can-build-wall 1 stone-wall)
=>
	(build-wall 1 stone-wall)
)
(defrule
	(current-age >= castle-age)
	(wall-completed-percentage 1 > 15)
	(can-build-gate 1)
=>
	(build-gate 1)
)
; --- perimetro interior: segundo anillo de piedra
(defrule
	(current-age >= castle-age)
	(wall-completed-percentage 1 > 45)
	(wall-completed-percentage 2 < 100)
	(can-build-wall 2 stone-wall)
=>
	(build-wall 2 stone-wall)
)
(defrule
	(current-age >= castle-age)
	(wall-completed-percentage 2 > 15)
	(can-build-gate 2)
=>
	(build-gate 2)
)

; =====================================================================
; INVESTIGACION (mejora rapida al estilo Barbarian)
; =====================================================================
; --- Edades (rapidas, con poblacion medida)
(defrule
	(current-age == dark-age)
	(unit-type-count-total villager >= 25)
	(can-research feudal-age)
=>
	(research feudal-age)
)
(defrule
	(current-age == feudal-age)
	(unit-type-count-total villager >= 32)
	(can-research castle-age)
=>
	(research castle-age)
)
(defrule
	(current-age == castle-age)
	(unit-type-count-total villager >= 75)
	(can-research imperial-age)
=>
	(research imperial-age)
)
; --- Economia
(defrule
	(current-age == dark-age)
	(unit-type-count villager >= 8)
	(can-research ri-loom)
=>
	(research ri-loom)
)
(defrule
	(can-research ri-double-bit-axe)
=>
	(research ri-double-bit-axe)
)
(defrule
	(can-research ri-horse-collar)
=>
	(research ri-horse-collar)
)
(defrule
	(can-research ri-gold-mining)
=>
	(research ri-gold-mining)
)
(defrule
	(can-research ri-wheel-barrow)
=>
	(research ri-wheel-barrow)
)
(defrule
	(goal gl-city cty-muralla)
	(can-research ri-stone-mining)
=>
	(research ri-stone-mining)
)
; --- Militar
(defrule
	(can-research ri-fletching)
=>
	(research ri-fletching)
)
(defrule
	(can-research ri-bodkin-arrow)
=>
	(research ri-bodkin-arrow)
)
(defrule
	(can-research ri-ballistics)
=>
	(research ri-ballistics)
)
(defrule
	(can-research ri-chemistry)
=>
	(research ri-chemistry)
)
(defrule
	(can-research ri-pikeman)
=>
	(research ri-pikeman)
)
(defrule
	(can-research ri-halberdier)
=>
	(research ri-halberdier)
)
(defrule
	(can-research ri-elite-skirmisher)
=>
	(research ri-elite-skirmisher)
)
(defrule
	(can-research ri-siege-engineers)
=>
	(research ri-siege-engineers)
)
(defrule
	(can-research ri-fortified-wall)
=>
	(research ri-fortified-wall)
)
(defrule
	(can-research my-unique-unit-upgrade)
=>
	(research my-unique-unit-upgrade)
)
(defrule
	(can-research my-unique-research)
=>
	(research my-unique-research)
)

; =====================================================================
; MILICIA: la mesnada del feudo
; =====================================================================
(defrule
	(can-train spearman-line)
	(unit-type-count-total spearman-line < 35)
=>
	(train spearman-line)
)
(defrule
	(can-train archer-line)
	(unit-type-count-total archer-line < 45)
=>
	(train archer-line)
)
(defrule
	(can-train skirmisher-line)
	(unit-type-count-total skirmisher-line < 15)
=>
	(train skirmisher-line)
)
(defrule
	(current-age >= castle-age)
	(can-train my-unique-unit)
	(unit-type-count-total my-unique-unit < 20)
=>
	(train my-unique-unit)
)
(defrule
	(current-age >= castle-age)
	(can-train battering-ram-line)
	(unit-type-count-total battering-ram-line < 6)
=>
	(train battering-ram-line)
)
(defrule
	(current-age >= imperial-age)
	(can-train trebuchet)
	(unit-type-count-total trebuchet < 4)
=>
	(train trebuchet)
)

; =====================================================================
; DEFENSA: la muralla viva
; =====================================================================
(defrule
	(goal gl-mode m-defend)
	(timer-triggered t-director)
=>
	(set-strategic-number sn-number-attack-groups 0)
	(set-strategic-number sn-number-defend-groups 6)
)
(defrule
	(goal gl-mode m-grow)
	(timer-triggered t-director)
=>
	(set-strategic-number sn-number-defend-groups 3)
)
(defrule
	(goal gl-mode m-attack)
	(timer-triggered t-director)
=>
	(set-strategic-number sn-number-defend-groups 2)
)

; =====================================================================
; DEFENSA COORDINADA (UserPatch: up-retreat-now / up-gather-inside)
; Refugio de guarnicion, retirada al centro y punteria del asedio.
; =====================================================================
; La guarnicion se refugia en castillo, centro y torres mientras atacan
; (up-gather-inside: los edificios de ese tipo retienen unidades [UP-docs]
; y el corpus lo usa 87x)
(defrule
	(timer-triggered t-director)
	(goal gl-mode m-defend)
	(town-under-attack)
=>
	(up-gather-inside c: town-center c: 1)
	(up-gather-inside c: castle c: 1)
	(up-gather-inside c: watch-tower c: 1)
)
; Calmada la tormenta, la guarnicion vuelve a salir
(defrule
	(timer-triggered t-director)
	(goal gl-mode m-grow)
	(not (town-under-attack))
=>
	(up-gather-inside c: town-center c: 0)
	(up-gather-inside c: castle c: 0)
	(up-gather-inside c: watch-tower c: 0)
)
; Retirada al centro urbano si nos superan (patron corpus 22x: se retira
; con ejercito escaso; up-retreat-now = "retreat all military to the
; home town center" [UP-docs])
(defrule
	(goal gl-mode m-defend)
	(town-under-attack)
	(military-population < 12)
=>
	(up-retreat-now)
)
; Punteria del asedio por modo (Barbarian documenta el SN con comentarios:
; default = "Trebs shoot only buildings", treb-value = "Trebs shoot units"
; [CORPUS: Barbarian.per]). Asalto: solo edificios. Defensa: libre.
(defrule
	(timer-triggered t-director)
	(goal gl-mode m-attack)
=>
	(set-strategic-number sn-free-siege-targeting 0)
)
(defrule
	(timer-triggered t-director)
	(goal gl-mode m-defend)
=>
	(set-strategic-number sn-free-siege-targeting 1)
)

; =====================================================================
; ASALTO ORGANIZADO (oleadas escalonadas + TSA)
; =====================================================================
(defrule
	(goal gl-mode m-attack)
	(goal gl-wave 0)
=>
	(set-goal gl-wave 1)
	(set-strategic-number sn-number-attack-groups 200)
	(set-strategic-number sn-maximum-town-size 40)
	(enable-timer t-push 8)
	(attack-now)
)
(defrule
	(goal gl-wave 1)
	(goal gl-mode m-defend)
=>
	(set-goal gl-wave 0)
	(set-strategic-number sn-number-attack-groups 0)
	(set-strategic-number sn-maximum-town-size 28)
)
; TSA: avance progresiva hacia el enemigo durante el asalto
(defrule
	(timer-triggered t-push)
	(goal gl-wave 1)
	(strategic-number sn-maximum-town-size < 180)
	(not (enemy-buildings-in-town))
=>
	(up-modify-sn sn-maximum-town-size c:+ 10)
)
(defrule
	(timer-triggered t-push)
	(goal gl-wave 1)
=>
	(attack-now)
)

; =====================================================================
; MICRO (DUC verificado: foco enemigo + fuego concentrado + asedio)
; =====================================================================
; Fuego concentrado de arqueros y hostigadores con formacion escalonada
(defrule
	(goal gl-wave 1)
	(timer-triggered t-micro)
	(not (enemy-buildings-in-town))
	(or	(unit-type-count archer-line > 3)
		(unit-type-count skirmisher-line > 3))
=>
	(up-get-player-fact this-any-enemy player-number 0 gl-temp)
	(up-modify-sn sn-focus-player-number g:= gl-temp)
	(up-full-reset-search)
	(up-find-local c: archer-line c: 20)
	(up-find-local c: skirmisher-line c: 20)
	(up-filter-include cmdid-military -1 -1 -1)
	(up-find-remote c: -1 c: 1)
	(up-get-search-state gl-local-total)
)
(defrule
	(goal gl-wave 1)
	(timer-triggered t-micro)
	(not (enemy-buildings-in-town))
	(up-compare-goal gl-local-total > 0)
	(up-compare-goal gl-remote-total > 0)
	(stance-toward focus-player enemy)
=>
	(up-target-objects 0 action-default formation-stagger stance-aggressive)
)
; El asedio prioriza EDIFICIOS: castillo, centro urbano, torres, resto
(defrule
	(goal gl-wave 1)
	(timer-triggered t-micro)
	(unit-type-count battering-ram-line > 0)
=>
	(up-get-player-fact this-any-enemy player-number 0 gl-temp)
	(up-modify-sn sn-focus-player-number g:= gl-temp)
	(up-full-reset-search)
	(up-find-local c: battering-ram-line c: 2)
	(up-find-remote c: castle c: 1)
	(up-find-remote c: town-center c: 1)
	(up-find-remote c: tower-class c: 1)
	(up-find-remote c: building-class c: 2)
	(up-get-search-state gl-local-total)
)
(defrule
	(goal gl-wave 1)
	(timer-triggered t-micro)
	(up-compare-goal gl-local-total > 0)
	(up-compare-goal gl-remote-total > 0)
	(stance-toward focus-player enemy)
=>
	(up-target-objects 0 action-default -1 stance-aggressive)
)

; =====================================================================
; MERCADO Y CUENTAS DEL FEUDO (bailiff)
; =====================================================================
(defrule
	(timer-triggered t-eco)
	(goal gl-city cty-muralla)
	(stone-amount < 100)
	(gold-amount > 900)
	(can-buy-commodity stone)
=>
	(buy-commodity stone)
)
(defrule
	(timer-triggered t-eco)
	(wood-amount > 1200)
	(can-sell-commodity wood)
=>
	(sell-commodity wood)
)
(defrule
	(timer-triggered t-eco)
	(food-amount < 150)
	(gold-amount > 1000)
	(can-buy-commodity food)
=>
	(buy-commodity food)
)
; Reparto de aldeanos por fase (los numeros del feudo)
(defrule
	(timer-triggered t-eco)
	(goal gl-city cty-aldea)
=>
	(set-strategic-number sn-food-gatherer-percentage 60)
	(set-strategic-number sn-wood-gatherer-percentage 35)
	(set-strategic-number sn-gold-gatherer-percentage 5)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
	(timer-triggered t-eco)
	(goal gl-city cty-villa)
=>
	(set-strategic-number sn-food-gatherer-percentage 45)
	(set-strategic-number sn-wood-gatherer-percentage 35)
	(set-strategic-number sn-gold-gatherer-percentage 20)
	(set-strategic-number sn-stone-gatherer-percentage 0)
)
(defrule
	(timer-triggered t-eco)
	(goal gl-city cty-muralla)
=>
	(set-strategic-number sn-food-gatherer-percentage 40)
	(set-strategic-number sn-wood-gatherer-percentage 30)
	(set-strategic-number sn-gold-gatherer-percentage 20)
	(set-strategic-number sn-stone-gatherer-percentage 10)
)
(defrule
	(timer-triggered t-eco)
	(goal gl-city cty-plaza)
=>
	(set-strategic-number sn-food-gatherer-percentage 35)
	(set-strategic-number sn-wood-gatherer-percentage 25)
	(set-strategic-number sn-gold-gatherer-percentage 25)
	(set-strategic-number sn-stone-gatherer-percentage 15)
)

; =====================================================================
; ARMADO INICIAL DE TIMERS (siempre junto al inicio)
; =====================================================================
(defrule
	(true)
=>
	(enable-timer t-director 2)
	(enable-timer t-micro 3)
	(enable-timer t-push 8)
	(enable-timer t-eco 20)
	(disable-self)
)

; =====================================================================
; REARME DE TIMERS (SIEMPRE AL FINAL: enable-timer limpia el trigger
; del pase; los consumidores deben ir antes - ver docs/01)
; =====================================================================
(defrule
	(timer-triggered t-director)
=>
	(enable-timer t-director 10)
)
(defrule
	(timer-triggered t-micro)
=>
	(enable-timer t-micro 3)
)
(defrule
	(timer-triggered t-push)
=>
	(enable-timer t-push 8)
)
(defrule
	(timer-triggered t-eco)
=>
	(enable-timer t-eco 20)
)
